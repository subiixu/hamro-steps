 import SwiftUI
 
+/// Layout constants for the flat, bento-style surfaces.
+enum Bento {
+    /// Corner radius of every tile on the main screens.
+    static let radius: CGFloat = 28
+    /// Gap between tiles, in both directions.
+    static let gap: CGFloat = 12
+    /// Inner padding of a tile.
+    static let padding: CGFloat = 20
+    /// A hairline edge instead of a shadow, so white tiles read on the canvas.
+    static let edge = Color.black.opacity(0.05)
+}
+
+extension View {
+    /// The flat tile surface: solid fill, continuous corners, hairline edge, no shadow.
+    func bentoSurface(_ fill: Color = .surface, radius: CGFloat = Bento.radius) -> some View {
+        background(fill, in: .rect(cornerRadius: radius, style: .continuous))
+            .overlay(
+                RoundedRectangle(cornerRadius: radius, style: .continuous)
+                    .strokeBorder(Bento.edge, lineWidth: 1)
+            )
+    }
+}
+
 /// Rounded surface used by every block on the main screens.
 struct Card<Content: View>: View {
+    var title: LocalizedStringKey?
     @ViewBuilder var content: Content
 
