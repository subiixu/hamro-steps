#!/usr/bin/env bash
# jarvis — runs the Jarvis script of the host this session is in, with the same arguments:
#
#   jarvis-superset   in a Superset terminal (SUPERSET_TERMINAL_ID set)
#   jarvis-ultron     in an Ultron session (ULTRON_SESSION_ID set), or anywhere the
#                     `ultron` daemon answers
#
# JARVIS_HOST=superset|ultron overrides the pick. Both scripts share handoffs/OPEN.md
# and handoffs/jarvis.conf; `jarvis help` (any unknown command) prints the chosen one's help.
set -u

dir=$(cd "$(dirname "$0")" && pwd)
host="${JARVIS_HOST:-}"
if [ -z "$host" ]; then
  if [ -n "${SUPERSET_TERMINAL_ID:-}" ]; then host=superset
  elif [ -n "${ULTRON_SESSION_ID:-}" ]; then host=ultron
  else
    case "${1:-}" in
      # every Claude session runs these: no host means no Jarvis to guard, and the
      # statusline tap and the band are the same in both scripts
      hook) exit 0 ;;
      statusline|band) host=superset ;;
      # `daemon status` asks without starting one (other ultron calls auto-start it)
      *) command -v ultron >/dev/null 2>&1 \
           && ultron daemon status --json 2>/dev/null | grep -q '"pid"' && host=ultron ;;
    esac
  fi
fi

case "$host" in
  superset|ultron) exec "$dir/jarvis-$host" "$@" ;;
  "") echo "jarvis: no host — run it in a Superset terminal (SUPERSET_TERMINAL_ID) or an Ultron session (ULTRON_SESSION_ID), or set JARVIS_HOST=superset|ultron" >&2 ;;
  *) echo "jarvis: JARVIS_HOST is superset or ultron, not $host" >&2 ;;
esac
exit 1
