#!/usr/bin/env bash
# nayo — the routine steps of the Nayo workflow, one command each, so the
# coordinator spends its turns on judgement instead of bookkeeping.
# This is the Superset host's script; handoffs/bin/nayo picks it or nayo-araniko.
#
#   nayo start                       claim this terminal as Nayo in OPEN.md, then status
#   nayo status                      band, workers, new handoffs, git — one short screen
#   nayo spawn <brief.md> [--after <handoff> | --redo <handoff> [--why "<line>"]] [--force]
#                [--isolate [--no-terminal]]
#                                      lint, enforce the band and the Claude cap, spawn, record
#                                      (--after: the next phase; --redo: sent back after review,
#                                      --why: the reason, written as why: in the brief's header;
#                                      --isolate or `isolate: yes` in the header: the worker gets
#                                      its own git worktree on branch jw/<slug>; --no-terminal
#                                      makes the worktree without starting a worker; refuses, without
#                                      --force, a non-isolated brief whose File scope overlaps a running
#                                      non-isolated worker's; a retried spawn finds the session the
#                                      first try started in handoffs/.nayo/requests/ instead of
#                                      starting a second)
#   nayo merge <handoff.md> --check  file list vs git status, diff stat, checks, the brief's File
#                                      scope and Acceptance command; changes nothing
#   nayo merge <handoff.md> --check --verify [--reuse]
#                                      also run the brief's ```bash verify``` blocks on HEAD + the
#                                      listed changes in a throwaway worktree (nayo-verify.py);
#                                      --reuse reports an identical recent pass instead
#   nayo merge <handoff.md> [-m <msg>] [--outcome <o>] [--no-push] [--keep-open] [--force]
#                [--skip-second-opinion "<reason>"]  (merge without the second opinion the
#                                      project's policy wants; logged in the handoff)
#                [--anyway "<reason>"] (merge despite a failed Acceptance, a file listed
#                                      outside the File scope, or the red checks Araniko ran on the
#                                      handoff; logged in the handoff; --force doesn't)
#                                      commit exactly the listed files + the handoff move,
#                                      push, close the worker, update OPEN.md (isolated: commit
#                                      on jw/<slug>, git merge it here; a conflict writes a
#                                      merge brief and changes nothing here)
#   nayo clean-worktrees             remove isolated worktrees + jw/* branches whose handoff
#                                      is merged and no worker is running; list the rest
#   nayo events                      one "[nayo event] …" line per handoff or worker trouble,
#                                      until killed: Nayo runs it under Claude Code's Monitor tool
#   nayo band                        the usage band from the latest statusline reading
#   nayo read <terminal> [lines]     a terminal's screen (also: nayo screen)
#   nayo send <terminal> "<text>"    type it into a worker and press Enter; exits non-zero when
#                                      Superset says it was typed but not submitted
#   nayo send <terminal> --keys enter press Enter alone (after a "not submitted"; then nayo read)
#   nayo close <terminal>            close a terminal: prints "closed <full id>" or Superset's error
#                                      (any <terminal> may be a unique prefix of a running id,
#                                      6+ characters)
#   nayo usage [--days N | --since DATE]
#                                      coordinating vs building, from local transcripts
#   nayo hook prompt                 UserPromptSubmit guard (from .claude/settings.json)
#   nayo lessons status|propose|show|apply|reject|retire|select
#                                    reviewed lessons from merged handoffs (nayo-lessons.py,
#                                    handoffs/LESSONS.md); propose makes one Sonnet call, apply
#                                    is the only writer; spawn adds the matching ones to the prompt
#   nayo statusline                  statusline tap: saves the 5-hour reading, then runs yours
#   nayo lock <class> [--wait <sec>] [--reuse] -- <command…>
#                                    runs the command under a named lease (nayo.conf NAYO_LOCK_*)
#   nayo resources [--json]          who holds each lease, and who is waiting
#
# Settings live in handoffs/nayo.conf; one developer's own team-mode settings in the untracked
# handoffs/nayo.local.conf (NAYO.md, "Shared repos (team mode)"). Works on the stock macOS bash (3.2).
# jq is needed for spawn, the hooks and the band; everything fails open without it.
set -u

# Nayo was called Jarvis before 2026-11-15. A JARVIS_* in the environment still counts
# where no NAYO_* of the same name is set. TODO(remove after first public release)
for v in $(env | sed -n 's/^JARVIS_\([A-Z0-9_]*\)=.*/\1/p'); do
  eval "[ -n \"\${NAYO_$v+x}\" ] || export NAYO_$v=\"\$JARVIS_$v\""
done

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
cd "$ROOT" || exit 0
H=handoffs
OPEN="$H/OPEN.md"
STATE="$H/.nayo"
BIN="$H/bin"

NAYO_MAX_CLAUDE=3      # Claude sessions at once, Nayo included; Codex/OpenCode/Grok don't count
NAYO_AMBER=50          # 5-hour % that turns the band amber
NAYO_RED=75            # 5-hour % that turns it red
NAYO_IDLE_MIN=55       # minutes idle after which a big context is cheaper to clear than reload
NAYO_GUARD_TOKENS=100000
NAYO_PUSH=1
# A project set up before the rename has handoffs/jarvis.conf (JARVIS_* names) until
# setup runs again. nayo.conf wins when both are there; they're never merged.
# TODO(remove after first public release)
if [ -f "$H/nayo.conf" ]; then
  [ -f "$H/jarvis.conf" ] && echo "nayo: using handoffs/nayo.conf (handoffs/jarvis.conf is ignored)" >&2
  # shellcheck disable=SC1090
  . "$H/nayo.conf"
elif [ -f "$H/jarvis.conf" ]; then
  # shellcheck disable=SC1090
  . "$H/jarvis.conf"
  for v in $(sed -n 's/^[[:space:]]*JARVIS_\([A-Z0-9_]*\)=.*/\1/p' "$H/jarvis.conf"); do
    eval "NAYO_$v=\"\$JARVIS_$v\""
  done
fi
# Team mode: a repo two developers share, each with their own Nayo (NAYO.md, "Shared repos").
# One developer's own settings live in the untracked handoffs/nayo.local.conf, read after
# nayo.conf: NAYO_OWNER (their name: their OPEN file, and what nayo writes under handoffs/),
# NAYO_ROLE (lead, the default, or contributor) and NAYO_OPEN (their OPEN file, by default
# handoffs/OPEN.<owner>.md). Without that file nothing changes. An older
# handoffs/jarvis.local.conf (JARVIS_OWNER, JARVIS_ROLE, JARVIS_OPEN) counts when there's no
# nayo.local.conf. TODO(remove after first public release)
# The role a local conf gives is the team role, kept in TEAM_ROLE; a NAYO_ROLE or JARVIS_ROLE
# from the environment (JARVIS_ROLE=worker on an older worker) stays as it was.
TEAM_CONF=""; TEAM_ROLE=""
for TEAM_F in "$H/nayo.local.conf" "$H/jarvis.local.conf"; do
  [ -f "$TEAM_F" ] && { TEAM_CONF=$TEAM_F; break; }
done
if [ -n "$TEAM_CONF" ]; then
  TEAM_EN=${NAYO_ROLE+x}; TEAM_ENV=${NAYO_ROLE:-}; TEAM_EJ=${JARVIS_ROLE+x}; TEAM_EJV=${JARVIS_ROLE:-}
  unset NAYO_ROLE JARVIS_ROLE
  # shellcheck disable=SC1090
  . "$TEAM_CONF"
  NAYO_OWNER=${NAYO_OWNER:-${JARVIS_OWNER:-}}; NAYO_OPEN=${NAYO_OPEN:-${JARVIS_OPEN:-}}
  TEAM_ROLE=${NAYO_ROLE:-${JARVIS_ROLE:-lead}}
  unset NAYO_ROLE JARVIS_ROLE
  [ -n "$TEAM_EN" ] && export NAYO_ROLE="$TEAM_ENV"
  [ -n "$TEAM_EJ" ] && export JARVIS_ROLE="$TEAM_EJV"
fi
case "${NAYO_OWNER:-}" in
  *[!A-Za-z0-9._-]*|.*) echo "nayo: NAYO_OWNER=$NAYO_OWNER: use letters, digits, . _ or - (it names handoffs/OPEN.<owner>.md)" >&2; exit 1 ;;
esac
if [ -n "${NAYO_OPEN:-}" ]; then OPEN=$NAYO_OPEN
elif [ -n "${NAYO_OWNER:-}" ]; then OPEN="$H/OPEN.$NAYO_OWNER.md"
fi
export NAYO_OPEN="$OPEN"   # jev.sh reads the usage band from it
WS="${SUPERSET_WORKSPACE_ID:-}"
# Isolated workers' worktrees: outside the repo and outside ~/.araniko, since Araniko lists a
# project's worktrees as branch Nayos. Their cargo builds share one target/ here.
WT_ROOT="${NAYO_WT_ROOT:-$HOME/.nayo-worktrees}"

LIMIT_RE="(usage|rate|session|weekly|daily|hourly|5-hour) limit (was |has been )?(reached|exceeded|hit)|(hit|reached|exceeded) (your|the) [a-z0-9 -]*limit|limit reached|quota (was |has been )?(exceeded|exhausted)|out of credits|too many requests"

die() { echo "nayo: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
now() { date +%s; }
short() { printf '%s' "$1" | cut -c1-8; }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

# ---------------------------------------------------------------- OPEN.md

nayo_terminal() {
  sed -n -E 's/^(Nayo|Jarvis) session:[[:space:]]*//p' "$OPEN" 2>/dev/null | head -n 1 | awk '{print $1}' | grep -v '^<' || true
}

# "- <when> · <agent>/<model> <effort> · term <id> · <brief> · <slug>"
running_lines() {
  awk '/^## /{on = ($0 ~ /^## Running workers/); next} on && /^- /' "$OPEN" 2>/dev/null
}

# The user's default model or effort for a Claude worker (Araniko's Settings → Nayo:
# workers.model, workers.effort), for a brief that names none. Empty without an araniko
# CLI or on an older daemon. Same rule as nayo-araniko's.
worker_default() { # <model|effort>
  have jq && have araniko || return 0
  araniko settings get "workers.$1" --json 2>/dev/null | jq -r '.value // empty' 2>/dev/null || true
}

claude_sessions() { # Nayo plus every running Claude worker
  echo $(( $(running_lines | grep -c '· claude/') + 1 ))
}

open_add_running() { # $1 = line
  local tmp; tmp=$(mktemp) || return 1
  awk -v line="$1" '{print} /^## Running workers/ && !done {print line; done=1}' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

open_drop() { # drop list items that mention $1
  local tmp; tmp=$(mktemp) || return 1
  awk -v k="$1" '!(/^- / && index($0, k))' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

open_set() { # $1 = "Nayo session" | "Usage band", $2 = value
  local tmp; tmp=$(mktemp) || return 1
  # An OPEN.md from before the rename says "Jarvis session:"; that line becomes "Nayo session:".
  awk -v k="$1" -v v="$2" 'index($0, k ":") == 1 || (k == "Nayo session" && index($0, "Jarvis session:") == 1) {print k ": " v; next} {print}' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

field() { # $1 = key, $2 = file: "key: value" from a brief header or handoff
  sed -n "s/^$1:[[:space:]]*//p" "$2" 2>/dev/null | head -n 1
}

# For spawn: one line when a Claude brief names a model other than the user's Workers default
# (Settings → Nayo → Workers model) without a reason in brackets. Never refuses. $1 = the
# brief's whole model: value, $2 = the default. Aliases match their full ids (opus = claude-opus-5-5).
model_tier_name() { printf '%s' "$1" | sed -E 's/^claude-//; s/-[0-9][0-9.-]*$//'; }
model_default_note() {
  local raw="$1" def="$2" m
  [ -n "$def" ] || return 0
  m=$(printf '%s' "$raw" | awk '{print $1}')
  case "$m" in \<*|""|default) return 0 ;; esac
  case "$raw" in *"("*")"*) return 0 ;; esac
  [ "$(model_tier_name "$m")" = "$(model_tier_name "$def")" ] && return 0
  echo "model: the brief names $m but your Workers default is $def, with no reason in brackets — spawning $m anyway (leave model: out to take the default, or write model: $m (<why>))"
}

# ---------------------------------------------------------------- band

# ---------------------------------------------------------------- team mode
# Loaded above from handoffs/nayo.local.conf; NAYO.md, "Shared repos (team mode)".

# An owner's OPEN file, the first time: handoffs/OPEN.md's text without its items (those
# stay with whoever wrote them).
open_seed() {
  [ -f "$OPEN" ] || [ "$OPEN" = "$H/OPEN.md" ] || [ ! -f "$H/OPEN.md" ] || {
    awk '/^- /{next} /^(Nayo|Jarvis) session:/{print "Nayo session: <nayo start writes it>"; next} {print}' "$H/OPEN.md" > "$OPEN" \
      && echo "made $OPEN from $H/OPEN.md (without its items, which stay there)"
  }
}

# File name $1 with the owner after its date (YYYY-MM-DD-HHMM-<owner>-<slug>.md), so two
# developers' handoffs and briefs never collide; unchanged without an owner or when it has it.
owner_name() {
  [ -n "${NAYO_OWNER:-}" ] || { printf '%s' "$1"; return; }
  case "$1" in *-"$NAYO_OWNER"-*|"$NAYO_OWNER"-*) printf '%s' "$1"; return ;; esac
  if printf '%s' "$1" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}-'; then
    printf '%s' "$1" | sed -E "s/^([0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4})-/\\1-$NAYO_OWNER-/"
  else
    printf '%s-%s' "$NAYO_OWNER" "$1"
  fi
}

# For spawn: warn when brief $1's name lacks the owner; the worker prompt's naming line.
owner_brief_warn() {
  [ -n "${NAYO_OWNER:-}" ] || return 0
  [ "$(owner_name "$(basename "$1")")" = "$(basename "$1")" ] \
    || echo "warning: $1 doesn't name its owner: call it $(dirname "$1")/$(owner_name "$(basename "$1")") so a teammate's brief can't collide with it"
}
owner_prompt() {
  [ -n "${NAYO_OWNER:-}" ] || return 0
  printf ' Name your handoff YYYY-MM-DD-HHMM-%s-<slug>.md: two developers share this repo, and the owner keeps your handoff apart from theirs.' "$NAYO_OWNER"
}

default_branch() { # origin/HEAD's target, else main, else master
  local b
  b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) && [ -n "$b" ] && { printf '%s' "${b#origin/}"; return; }
  for b in main master; do
    { git show-ref -q --verify "refs/heads/$b" || git show-ref -q --verify "refs/remotes/origin/$b"; } && { printf '%s' "$b"; return; }
  done
  printf main
}

# start/status, in team mode: role · branch · open file
team_line() {
  local cur b
  [ -n "$TEAM_CONF" ] || return 0
  cur=$(git symbolic-ref -q --short HEAD 2>/dev/null || echo detached)
  printf 'team: %s · %s · %s\n' "$TEAM_ROLE" "$cur" "$OPEN"
  case "$TEAM_ROLE" in
    lead) ;;
    contributor)
      b=$(default_branch)
      [ "$cur" != "$b" ] && [ "$cur" != detached ] \
        || echo "  ! a contributor never commits on $b: start a branch first, git switch -c ${NAYO_OWNER:-<name>}/<topic> origin/$b" ;;
    *) echo "  ! NAYO_ROLE=$TEAM_ROLE in $TEAM_CONF: give lead or contributor" ;;
  esac
}

# A lead takes what teammates pushed: fetch, then fast-forward, or rebase the commits
# origin doesn't have yet (a push that failed earlier) onto it. The rebase runs in a scratch
# worktree, so this checkout's uncommitted work is never stashed, and lands with
# `reset --keep`, which refuses rather than touch a file with uncommitted changes. Never a
# force push, a stash or a merge commit. Sets CATCH_DONE (what it did, empty when there was
# nothing to take); returns 1 with CATCH_WHY when it can't, and then nothing has moved.
catch_up() {
  local up upsha behind ahead overlap tmp new conflicts
  CATCH_DONE=""; CATCH_WHY=""
  up=$(git rev-parse -q --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) && [ -n "$up" ] || return 0
  git fetch -q 2>/dev/null || { CATCH_DONE="git fetch failed, so not caught up with $up"; return 0; }
  upsha=$(git rev-parse -q --verify '@{u}' 2>/dev/null) || return 0
  behind=$(git rev-list --count "HEAD..$upsha" 2>/dev/null) || return 0
  [ "${behind:-0}" -gt 0 ] || return 0
  ahead=$(git rev-list --count "$upsha..HEAD" 2>/dev/null)
  overlap=$(git diff --name-only HEAD "$upsha" 2>/dev/null | grep -xF -f <(changed_paths) 2>/dev/null | head -n 8 | tr '\n' ' ')
  if [ "${ahead:-0}" = 0 ]; then
    if git merge -q --ff-only "$upsha" >/dev/null 2>&1; then
      CATCH_DONE="caught up: fast-forwarded $behind commit(s) from $up"; return 0
    fi
    CATCH_WHY="can't catch up with $up: its $behind new commit(s) change ${overlap:-files} with uncommitted changes here. Nothing merged and the branch is as it was; take $up in by hand (commit or move those changes, then git merge --ff-only @{u}) and merge again"
    return 1
  fi
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/nayo-catch-up.XXXXXX") || { CATCH_WHY="no scratch folder to rebase in"; return 1; }
  if ! git worktree add -q --detach "$tmp" HEAD >/dev/null 2>&1; then
    rm -rf "$tmp"; CATCH_WHY="couldn't make a scratch worktree to rebase $ahead local commit(s) onto $up"; return 1
  fi
  if git -C "$tmp" rebase -q --rebase-merges "$upsha" >/dev/null 2>&1; then
    new=$(git -C "$tmp" rev-parse HEAD)
  else
    conflicts=$(git -C "$tmp" diff --name-only --diff-filter=U 2>/dev/null | head -n 8 | tr '\n' ' ')
    git -C "$tmp" rebase --abort >/dev/null 2>&1
  fi
  git worktree remove --force "$tmp" >/dev/null 2>&1; rm -rf "$tmp"; git worktree prune 2>/dev/null
  if [ -z "${new:-}" ]; then
    CATCH_WHY="can't catch up with $up: rebasing this branch's $ahead unpushed commit(s) onto its $behind new one(s) conflicts${conflicts:+ in $conflicts}. Nothing merged and the branch is as it was; rebase by hand (git pull --rebase once the checkout is clean), never force-push"
    return 1
  fi
  if ! git reset -q --keep "$new" >/dev/null 2>&1; then
    CATCH_WHY="can't catch up with $up: its $behind new commit(s) change ${overlap:-files} with uncommitted changes here. Nothing merged and the branch is as it was; commit or move those changes, then git pull --rebase, and merge again"
    return 1
  fi
  CATCH_DONE="caught up: rebased $ahead unpushed commit(s) onto $behind new one(s) from $up"
}

# Before a merge commit, in team mode ($1 = 1 when the merge will push): a lead catches up
# with origin first; a contributor must be on its own branch, never the default one.
team_guard() {
  local b cur
  [ -n "$TEAM_CONF" ] || return 0
  case "$TEAM_ROLE" in
    lead)
      [ "$1" = 1 ] && [ -n "$(git remote)" ] || return 0
      catch_up || die "$CATCH_WHY"
      [ -z "$CATCH_DONE" ] || echo "  $CATCH_DONE" ;;
    contributor)
      b=$(default_branch); cur=$(git symbolic-ref -q --short HEAD 2>/dev/null)
      [ -n "$cur" ] || die "contributor Nayo: HEAD is detached. Start a branch first: git switch -c ${NAYO_OWNER:-<name>}/<topic> origin/$b"
      [ "$cur" != "$b" ] || die "contributor Nayo: never commit on $b. Start a branch first: git switch -c ${NAYO_OWNER:-<name>}/<topic> origin/$b" ;;
    *) die "NAYO_ROLE=$TEAM_ROLE in $TEAM_CONF: give lead or contributor" ;;
  esac
}

# The push after a merge commit, in team mode; prints the summary line's push part. A
# contributor pushes its branch (-u origin HEAD) for a PR. A lead pushes, and when origin
# rejects it, catches up once and pushes again.
team_push() {
  local cur
  cur=$(git symbolic-ref -q --short HEAD 2>/dev/null)
  [ -n "$(git remote)" ] || { echo "not pushed (no remote)"; return; }
  if [ "$TEAM_ROLE" = contributor ]; then
    if git push -q -u origin HEAD 2>/dev/null; then echo "pushed $cur (open its PR: gh pr create --base $(default_branch))"
    else echo "push failed, so $cur stays local until the next push (git push -u origin HEAD)"; fi
    return
  fi
  set -- -q
  git rev-parse -q --abbrev-ref '@{upstream}' >/dev/null 2>&1 || set -- -q -u origin "$cur"
  if git push "$@" 2>/dev/null; then echo pushed; return; fi
  if catch_up; then
    if [ -n "$CATCH_DONE" ] && git push "$@" 2>/dev/null; then echo "push rejected, so $CATCH_DONE, then pushed"
    else echo "push failed${CATCH_DONE:+ ($CATCH_DONE)}, so the commit stays local until the next push"; fi
  else
    echo "push rejected and the catch-up failed, so the commit stays local: $CATCH_WHY"
  fi
}

# Prints "<band>\t<one-line explanation>". The reading comes from `nayo statusline`,
# which Claude Code feeds its own 5-hour and 7-day rate-limit numbers.
band() {
  local f="$STATE/usage.json"
  have jq || { printf 'unknown\tjq not installed\n'; return; }
  [ -s "$f" ] || { printf 'unknown\tno statusline reading yet — check `/usage` and write the band by hand\n'; return; }
  jq -r --argjson now "$(now)" --argjson amber "$NAYO_AMBER" --argjson red "$NAYO_RED" '
    def hm: (. / 60 | floor) as $m | "\($m / 60 | floor)h\($m % 60 | tostring | if length < 2 then "0" + . else . end)m";
    (.five_hour.used_percentage // null) as $u
    | (.five_hour.resets_at // null) as $r
    | (.seven_day.used_percentage // null) as $w
    | (($now - .ts) / 60 | floor) as $age
    | if $u == null or $r == null then "unknown\tthe reading has no 5-hour window"
      elif $now >= $r then "green\tthe 5-hour window has reset since the last reading (\($age) min ago)"
      else
        (18000 - ($r - $now)) as $el
        | (if $el >= 1800 then ($u * 18000 / $el) else null end) as $pace
        | (if $u >= $red or ($w // 0) >= 95 then "red"
           elif $u >= $amber or ($pace // 0) >= 100 or ($w // 0) >= 80 then "amber"
           else "green" end) as $b
        | "\($b)\t5h \($u | round)% used, \($el | hm) into the window"
          + (if $pace then ", on pace for \($pace | round)%" else "" end)
          + (if $w then " · 7d \($w | round)%" else "" end)
          + (if $age > 20 then " · reading \($age) min old" else "" end)
      end' "$f" 2>/dev/null || printf 'unknown\tunreadable %s\n' "$f"
}

cmd_band() { band | tr '\t' ' '; }

# ---------------------------------------------------------------- start / status

# Araniko session $1: 0 if it's still open, 1 if not, 2 if the daemon can't be asked.
araniko_open() {
  local u list st
  u=$(command -v araniko 2>/dev/null) || u="${ARANIKO_HOME:-$HOME/.araniko}/bin/araniko"
  [ -x "$u" ] && have jq || return 2
  # no daemon, no sessions (and `term list` would start one)
  list=$("$u" daemon status --json 2>/dev/null) || return 2
  printf '%s' "$list" | grep -q '"pid"' || return 1
  list=$("$u" term list --all --json 2>/dev/null) || return 2
  st=$(printf '%s' "$list" | jq -r --arg id "$1" '.[]? | select(.id == $id) | .state // empty' 2>/dev/null | head -n 1)
  case "$st" in ""|exited|failed) return 1 ;; *) return 0 ;; esac
}

# Superset terminal $1: prints "<name> (<id>)" of the first workspace on this checkout
# where it's still running, or nothing. Looks at every workspace whose path is this
# checkout (plus $WS), not just this one: on 2026-10-20 a second Nayo in another
# workspace took over the line. Superset unreachable → falls back to $WS alone.
superset_alive_in() {
  local id="$1" here wss ws name sessions
  have superset || return 0
  here=$(cd "$ROOT" 2>/dev/null && pwd -P) || here="$ROOT"
  wss=""
  if have jq && sessions=$(superset workspaces list --json 2>/dev/null); then
    wss=$(printf '%s' "$sessions" | jq -r --arg here "$here" --arg ws "$WS" '
      .[]? | select(.archivedAt == null)
      | select(.id == $ws or .worktreePath == null
               or ((.worktreePath | sub("/+$"; "")) == $here))
      | "\(.id)\t\(.name // "")"' 2>/dev/null)
  fi
  [ -n "$wss" ] || { [ -n "$WS" ] && wss=$(printf '%s\t%s' "$WS" "this one"); }
  while IFS="$(printf '\t')" read -r ws name; do
    [ -n "$ws" ] || continue
    sessions=$(superset terminals list --workspace "$ws" --json 2>/dev/null) || continue
    if have jq; then
      printf '%s' "$sessions" | jq -e --arg id "$id" \
        '[.sessions[]? | select(.terminalId == $id and (.exited | not))] | length > 0' >/dev/null 2>&1 \
        || continue
    else
      printf '%s' "$sessions" | grep -q "$id" || continue
    fi
    printf '%s (%s)\n' "${name:-?}" "$ws"
    return 0
  done <<EOF
$wss
EOF
}

cmd_start() {
  local me old where
  open_seed
  me="${SUPERSET_TERMINAL_ID:-}"
  [ -f "$OPEN" ] || die "no $OPEN — run nayo:setup first"
  [ -n "$me" ] || die "SUPERSET_TERMINAL_ID not set — run Nayo in a Superset terminal"
  old=$(nayo_terminal)
  case "$old" in
    s_*) # a Nayo in Araniko (its ids are s_…): ask its daemon
      if [ "${1:-}" != --force ]; then
        araniko_open "$old"
        case $? in
          0) die "another Nayo ($old, in Araniko) is still open — ask the user, then: nayo start --force" ;;
          2) die "can't check whether the Araniko Nayo ($old) is still open (araniko not reachable) — ask the user, then: nayo start --force" ;;
        esac
      fi ;;
    *)
      if [ -n "$old" ] && [ "$old" != "$me" ] && [ "${1:-}" != --force ]; then
        where=$(superset_alive_in "$old")
        [ -n "$where" ] && die "another Nayo ($old) is still open in Superset workspace $where — ask the user, then: nayo start --force"
      fi ;;
  esac
  open_set "Nayo session" "$me"
  mkdir -p "$STATE"
  # for nayo-araniko's "still open?" check: Araniko strips SUPERSET_* from its sessions
  printf 'workspace=%s\norganization=%s\n' "$WS" "${SUPERSET_ORGANIZATION_ID:-}" > "$STATE/superset.host"
  cmd_status
}

cmd_status() {
  local b line id brief ho ids="" n=0 changed claimed unclaimed
  open_seed
  [ -f "$OPEN" ] || die "no $OPEN — run nayo:setup first"

  b=$(band)
  printf 'band: %s\n' "$(printf '%s' "$b" | tr '\t' ' ' | sed 's/ /: /')"
  team_line
  case "$(printf '%s' "$b" | cut -f1)" in
    green|amber|red) open_set "Usage band" "$(printf '%s' "$b" | cut -f1) ($(printf '%s' "$b" | cut -f2 | cut -d, -f1), $(date +%H:%M))" ;;
  esac

  disk_warn
  echo "events: arm Monitor on handoffs/bin/nayo events"
  printf 'claude sessions: %s of %s (Nayo included)\n' "$(claude_sessions)" "$NAYO_MAX_CLAUDE"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    n=$((n + 1))
    id=$(printf '%s' "$line" | sed -n 's/.*term \([^ ]*\).*/\1/p')
    brief=$(printf '%s' "$line" | grep -o "$H/briefs/[^ ]*\.md" | head -n 1)
    ho=""
    [ -n "$brief" ] && ho=$(grep -l "^brief:[[:space:]]*$brief" "$H"/*.md 2>/dev/null | head -n 1)
    printf '  %s %s %s' "$(short "$id")" "$(printf '%s' "$line" | awk -F' · ' '{print $2}')" "$(basename "${brief:-?}" .md)"
    if [ -n "$ho" ]; then printf '  → %s (%s)\n' "$ho" "$(field status "$ho")"; else echo; fi
    iso_status "$line"
    [ -n "$id" ] && [ -z "$ho" ] && ids="$ids $id"
  done <<EOF
$(running_lines)
EOF
  [ $n = 0 ] && echo "  no workers running"

  if [ -n "$ids" ]; then
    echo "workers still at it:"
    if [ -x "$BIN/jev.sh" ]; then
      # shellcheck disable=SC2086
      "$BIN/jev.sh" triage $ids 2>/dev/null | sed 's/^/  /'
    else
      for id in $ids; do
        printf '  %s\n' "$(short "$id")"
        superset terminals read --workspace "$WS" --terminal "$id" --max-lines 40 --json 2>/dev/null \
          | { have jq && jq -r '.text // empty' || cat; } | sed -e 's/[[:space:]]*$//' | grep -v '^$' | tail -n 4 | sed 's/^/      /'
      done
    fi
  fi

  # handoffs on disk that no running worker accounts for
  for ho in "$H"/*.md; do
    [ -f "$ho" ] || continue
    case "$(basename "$ho")" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.md) ;; *) continue ;; esac
    brief=$(field brief "$ho")
    running_lines | grep -q "${brief:-@@none@@}" && continue
    echo "handoff not tied to a running worker: $ho ($(field status "$ho"))"
  done

  changed=$(git status --porcelain -uall 2>/dev/null | grep -v " $H/" | wc -l | tr -d ' ')
  claimed=0
  for ho in "$H"/*.md; do [ -f "$ho" ] && claimed=$((claimed + $(listed_files "$ho" | wc -l))); done
  unclaimed=$((changed - claimed)); [ $unclaimed -lt 0 ] && unclaimed=0
  printf 'git: %s changed outside handoffs/ · about %s not in any handoff yet · %s\n' \
    "$changed" "$unclaimed" "$(git log -1 --format='last commit %h %ar' 2>/dev/null)"
  n=$(awk '/^## /{on = ($0 ~ /^## To-do/); next} on && /^- /' "$OPEN" | wc -l | tr -d ' ')
  q=$(awk '/^## /{on = ($0 ~ /^## Questions for the user/); next} on && /^- /' "$OPEN" | wc -l | tr -d ' ')
  printf "%s: %s question(s) for the user · %s to-do\n" "$(basename "$OPEN")" "$q" "$n"
  finished_todos
}

# For `status`: To-do lines that look finished ("shipped", "merged", "done",
# "dropped", "retired", "reverted", or a commit sha in parentheses). To-do holds
# only work not done yet (NAYO.md, "What goes in OPEN.md"). Five at most.
finished_todos() {
  local line w=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    w=$((w + 1)); [ $w -le 5 ] || break
    [ ${#line} -gt 60 ] && line="${line:0:60}…"
    printf 'to-do looks finished: "%s" — take it out of To-do; if the user should check it, add a manual test (<what>): line under Questions for the user\n' "$line"
  done <<EOF
$(awk '
  /^## /{on = ($0 ~ /^## To-do/); next}
  on && /^- / {
    l = tolower($0)
    if (l ~ /(^|[^a-z0-9_])(shipped|merged|done|dropped|retired|reverted)([^a-z0-9_]|$)/ ||
        l ~ /\(([^)]*[^0-9a-z])?[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]+([^0-9a-z][^)]*)?\)/) {
      sub(/^- +/, ""); print
    }
  }' "$OPEN")
EOF
}

# ---------------------------------------------------------------- libraries

# Every brief gets `## Libraries and design rules`: what `araniko knowledge show`
# says for this project (the user's libraries, design rules), so workers follow
# them too, not only Nayo. Never blocks a spawn: a missing araniko, an error or
# a slow daemon leaves one "(knowledge unavailable: …)" line instead.
KNOWLEDGE_SEC=5

araniko_cli() { # on PATH, else ~/.araniko/bin/araniko
  if have araniko; then command -v araniko
  elif [ -x "$HOME/.araniko/bin/araniko" ]; then echo "$HOME/.araniko/bin/araniko"
  else return 1; fi
}

# Run "$@" for at most $1 seconds; non-zero when it was cut off. The stock macOS
# has no timeout(1). Give it a file, not a pipe, for stdout: a cut-off child can
# outlive the kill and would hold a pipe open.
time_boxed() {
  local secs=$1 pid w rc; shift
  "$@" & pid=$!
  ( sleep "$secs"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 & w=$!
  wait "$pid"; rc=$?
  kill "$w" 2>/dev/null; wait "$w" 2>/dev/null
  return $rc
}

one_line() { # the daemon's error from araniko's output $1, else its first line
  local e
  e=$(printf '%s' "$1" | jq -r '.error // empty' 2>/dev/null)
  [ -n "$e" ] || e=$(printf '%s\n' "$1" | sed -n '/[^[:space:]]/{p;q;}')
  printf '%s' "${e:-no output}" | cut -c1-160
}

knowledge_fetch() { # $1 = the araniko CLI, $2 = the project id (empty: look it up)
  local u=$1 proj=${2:-} out
  if [ -z "$proj" ]; then
    out=$("$u" project get --json 2>&1) || { echo "(knowledge unavailable: $(one_line "$out"))"; return 0; }
    proj=$(printf '%s' "$out" | jq -r '.id // empty' 2>/dev/null)
    [ -n "$proj" ] || { echo "(knowledge unavailable: no project id from araniko project get)"; return 0; }
  fi
  # --for worker leaves out files marked audience: nayo; an older araniko without the flag fails it.
  out=$("$u" knowledge show --project "$proj" --for worker --json 2>/dev/null) ||
    out=$("$u" knowledge show --project "$proj" --json 2>&1) || { echo "(knowledge unavailable: $(one_line "$out"))"; return 0; }
  out=$(printf '%s' "$out" | jq -r '.text // empty' 2>/dev/null) || { echo "(knowledge unavailable: unreadable output from araniko knowledge show)"; return 0; }
  [ -n "$out" ] || out="(no shared knowledge applies to this project)"
  printf '%s\n' "$out"
}

# Write the knowledge into brief $1 under `## Libraries and design rules`,
# replacing that section if it's there: after `## Context`, else before
# `## Scope`, else at the end. Its own headings are pushed down two levels so
# they can't end the section.
stamp_knowledge() { # $1 = brief, $2 = the project id (empty: araniko project get)
  local brief=$1 u tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/nayo-kn.XXXXXX") || return 0
  if ! u=$(araniko_cli); then
    echo "(knowledge unavailable: araniko not found)" > "$tmp"
  elif ! time_boxed "$KNOWLEDGE_SEC" knowledge_fetch "$u" "${2:-}" > "$tmp" 2>/dev/null || [ ! -s "$tmp" ]; then
    echo "(knowledge unavailable: araniko didn't answer within ${KNOWLEDGE_SEC} s)" > "$tmp"
  fi
  sed -E 's/^(#+[[:space:]])/##\1/' "$tmp" > "$tmp.md"
  awk -v hasctx="$(grep -c '^## Context' "$brief")" '
    FNR == NR { kn = kn $0 "\n"; next }
    function emit() {
      if (done) return
      printf "## Libraries and design rules\n<!-- written by nayo spawn from `araniko knowledge show`; replaced on every spawn -->\n%s\n", kn
      done = 1
    }
    /^## / {
      skip = 0
      if ($0 ~ /^## Libraries and design rules[[:space:]]*$/) { skip = 1; next }
      if (inctx) { emit(); inctx = 0 }
      if ($0 ~ /^## Context/) inctx = 1
      else if (hasctx == 0 && $0 ~ /^## Scope/) emit()
    }
    skip { next }
    { print }
    END { if (!done) { print ""; emit() } }
  ' "$tmp.md" "$brief" > "$brief.tmp" && mv "$brief.tmp" "$brief"
  case "$(sed -n '1p' "$tmp")" in
    "(knowledge unavailable"*) echo "libraries: $(sed -n '1p' "$tmp") — spawning anyway" ;;
    *) echo "libraries: $(wc -l < "$tmp" | tr -d ' ') line(s) of shared knowledge written into the brief" ;;
  esac
  rm -f "$tmp" "$tmp.md" "$brief.tmp"
}

# ---------------------------------------------------------------- spawn

# Record in the header of brief $1 what it follows on: `$2: $3` (after = the next
# phase, redo = sent back), on its own line under `started:`, then `why: $4` (the
# reason a redo was sent back) when given. Any earlier after:/redo:/why: line goes;
# with no $2, that's all it does.
brief_follows() {
  WHY="${4:-}" awk -v key="${2:-}" -v val="${3:-}" '
    /^## / { body = 1 }
    !body && /^(after|redo|why):/ { next }
    { print }
    !body && !done && key != "" && /^started:/ {
      print key ": " val
      if (ENVIRON["WHY"] != "") print "why: " ENVIRON["WHY"]
      done = 1
    }
    END { if (key != "" && !done) exit 3 }
  ' "$1" > "$1.tmp" || { rm -f "$1.tmp"; return 1; }
  mv "$1.tmp" "$1"
}

# ---------------------------------------------------------------- tasks

# What the user asked for, from Araniko's Tasks (docs/design/tasks-v2.md §4.1). A
# brief names the tasks it works on in its header, under `started:`:
# `Tasks: T-41, T-42`, optionally `Tasks: T-42 (part 1 of 2)`; `41` is T-41 and an
# old ask id (31.2) still works. Older briefs' `Asks: 31.2, 31` (31 = the whole
# message) are read too. Checked against `araniko tasks list`. A missing araniko, a
# CLI without `tasks`, an error or no answer within ASKS_SEC skips the checks:
# they never block a spawn.
ASKS_SEC=5

# The tasks araniko knows, one "<id>\t<state>" per line: each task by its number
# (T-41) and by its old ask id (31.2), and each message (31). The state is the
# task's status, `skipped-user`/`skipped-nayo` when skipped, `removed` when
# removed. $1 = the araniko CLI, then flags for `tasks list` (--open). Always
# `--peek`, so reading the list here never marks the user's changes as seen. Falls back
# to `asks list` on an older CLI. Fails when it can't tell.
asks_known() {
  local u=$1 out; shift
  out=$("$u" tasks list "$@" --peek --json 2>/dev/null) || out=$("$u" asks list "$@" --json 2>/dev/null) || return 1
  out=$(printf '%s' "$out" | jq -r '
    def state:
      if ((.removed_at // .removed // .became_note // false) | . != false and . != null) or .status == "removed" then "removed"
      elif .status == "skipped" or .ending == "skipped" then "skipped-\(.skipped_by // "user")"
      else (.status // "-") end;
    def tno: (.tno // (if (.id | type) == "string" and (.id | test("^T-[0-9]+$")) then .id[2:] else null end)) | tostring | select(test("^[0-9]+$"));
    def askid: [.id, .ask][] | strings | select(test("^[0-9]+[.][0-9]+$"));
    ( .. | objects | select(has("tno") or ((.id? | strings | test("^(T-)?[0-9]+([.][0-9]+)?$")) // false) and has("status"))
      | state as $s | ("T-" + tno), askid | "\(.)\t\($s)" ),
    ( .. | objects | select(((.n // null) | numbers) != null and (.asks? | arrays) != null)
      | "\(.n)\t\(if (.asks | length) == 0 then "not_split" else "-" end)" )
  ' 2>/dev/null) || return 1
  [ -z "$out" ] || printf '%s\n' "$out" | sort -u
}

# The ids in a Tasks: or Asks: value $1, one per line, without "(part 1 of 2)".
header_ids() {
  printf '%s' "$1" | sed -E 's/[[:space:]]*\(part [0-9]+ of [0-9]+\)$//' | tr ', ' '\n\n' | sed '/^$/d'
}

# Lint brief $1's Tasks: line (or an older Asks: line) ($2 = 1 for --force) and
# leave it in ASKS for the spawn line. A malformed line refuses; an id araniko
# doesn't know refuses unless --force; a task the user (or Nayo) skipped or
# removed always refuses; no line while tasks are open only warns.
check_asks() {
  local brief=$1 force=${2:-0} key="" val ids bad u tmp id st line
  ASKS=""
  key=$(awk '/^## /{exit} /^(Tasks|Asks):/{sub(/:.*/, ""); print; exit}' "$brief")
  if [ -n "$key" ]; then
    val=$(awk -v k="$key" '/^## /{exit} index($0, k ":") == 1 {sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit}' "$brief")
    ids=$(header_ids "$val")
    if [ "$key" = Tasks ]; then
      [ -n "$ids" ] || die "brief has an empty Tasks: line (put the task numbers, e.g. Tasks: T-41, or remove the line)"
      bad=$(printf '%s\n' "$ids" | grep -vE '^(T-)?[0-9]+$|^[0-9]+[.][0-9]+$' | head -n 1)
      [ -z "$bad" ] || die "'$bad' in the brief's Tasks: line isn't a task number (T-41, then an optional (part 1 of 2))"
      ids=$(printf '%s\n' "$ids" | sed -E 's/^([0-9]+)$/T-\1/')
    else
      [ -n "$ids" ] || die "brief has an empty Asks: line (put the ask ids, e.g. Asks: 31.2, or remove the line)"
      bad=$(printf '%s\n' "$ids" | grep -vE '^[0-9]+([.][0-9]+)?$' | head -n 1)
      [ -z "$bad" ] || die "'$bad' in the brief's Asks: line isn't an ask id (31.2, or 31 for the whole message, then an optional (part 1 of 2))"
    fi
    ASKS=$val
  fi
  u=$(araniko_cli) || return 0
  tmp=$(mktemp "${TMPDIR:-/tmp}/nayo-asks.XXXXXX") || return 0
  if [ -n "$key" ]; then
    if time_boxed "$ASKS_SEC" asks_known "$u" > "$tmp" 2>/dev/null; then
      bad=""
      while read -r id; do
        line=$(awk -F '\t' -v id="$id" '$1 == id {print $2; exit}' "$tmp")
        case "$line" in
          skipped-nayo) rm -f "$tmp"; die "$id was skipped by Nayo — don't brief it (bring it back in the Nayo tab first)" ;;
          skipped-*) rm -f "$tmp"; die "$id was skipped by the user — don't brief it unless they bring it back" ;;
          removed) rm -f "$tmp"; die "$id was removed by the user — it isn't a task any more" ;;
          "")
            # an older CLI with no T numbers can't vouch for T-41
            case "$id" in T-*) grep -q '^T-' "$tmp" || continue ;; esac
            bad="$bad$id " ;;
        esac
      done <<EOF
$ids
EOF
      if [ -n "$bad" ]; then
        rm -f "$tmp"
        [ "$force" = 1 ] || die "no task ${bad% } in this project (araniko tasks list; or the user removed it) — fix the brief's $key: line, or --force if the list is wrong"
        echo "tasks: ${bad% } not in araniko tasks list — spawning anyway (--force)"
      fi
    fi
  elif time_boxed "$ASKS_SEC" asks_known "$u" --open > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    # T numbers when the CLI has them, else ask ids; a message only when it isn't split yet
    st=$(awk -F '\t' '
      $2 ~ /^(skipped|removed|done|answered)/ { next }
      $1 ~ /^T-/ { t[++nt] = $1; next }
      $1 ~ /[.]/ { a[++na] = $1; next }
      $2 == "not_split" { m[++nm] = $1 " (not split yet)" }
      END {
        if (nt) for (i = 1; i <= nt; i++) printf "%s%s", (n++ ? ", " : ""), t[i]
        else for (i = 1; i <= na; i++) printf "%s%s", (n++ ? ", " : ""), a[i]
        for (i = 1; i <= nm; i++) printf "%s%s", (n++ ? ", " : ""), m[i]
      }' "$tmp")
    [ -z "$st" ] || echo "tasks: warning — the brief has no Tasks: line, but these are open: $st. Put the ones it works on in a Tasks: line under started:. Spawning anyway"
  fi
  rm -f "$tmp"
}

# §2 rule 2: a brief carries only the notes that matter for its job, since every
# line is re-read on every worker turn. Warns (never refuses) when more than
# NOTES_MAX lines of brief $1 match notes from `araniko notes list`. The Libraries
# section nayo spawn writes isn't counted. Skipped silently without araniko.
NOTES_MAX=5
check_notes() {
  local brief=$1 u tmp n
  u=$(araniko_cli) || return 0
  tmp=$(mktemp "${TMPDIR:-/tmp}/nayo-notes.XXXXXX") || return 0
  if time_boxed "$ASKS_SEC" notes_known "$u" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    n=$(awk '
      function norm(s) {
        gsub(/<!--[^>]*-->/, "", s); s = tolower(s)
        sub(/^[[:space:]]*([-*+]|[0-9]+[.)])[[:space:]]+/, "", s)
        gsub(/[`*_"]/, "", s); gsub(/[[:space:]]+/, " ", s)
        sub(/^ /, "", s); sub(/[ .;:,]+$/, "", s)
        return s
      }
      FNR == NR { s = norm($0); if (length(s) >= 8) notes[++nn] = s; next }
      /^## / { skip = ($0 ~ /^## Libraries and design rules/) }
      skip { next }
      { l = norm($0); if (l == "") next
        for (i = 1; i <= nn; i++) if (index(l, notes[i])) { hits++; break } }
      END { print hits + 0 }
    ' "$tmp" "$brief")
    [ "$n" -le "$NOTES_MAX" ] || echo "notes: warning — $n lines of the brief repeat notes from handoffs/NOTES.md (more than $NOTES_MAX). Keep only the ones that matter for this job: every line is re-read on every worker turn. Spawning anyway"
  fi
  rm -f "$tmp"
}

# The notes' texts, one per line. $1 = the araniko CLI. Fails when it can't tell.
notes_known() {
  local out
  out=$("$1" notes list --json 2>/dev/null) || return 1
  printf '%s' "$out" | jq -r '
    if type == "array" then .[] else (.notes // [])[] end
    | if type == "string" then . else (.text // empty) end
  ' 2>/dev/null
}

# ---------------------------------------------------------------- request ids, files:

# A fixed request id for one daemon call: nayo-<what>-<16 hex of a hash of the rest>.
# The daemon answers a repeat of an id from what it did the first time (for 24 hours), so
# a retried spawn or merge never does it twice. A spawn's id hashes the brief's path and
# its started: line, which a spawn rewrites once it has its session: a retry after a
# failure finds the same id, and a deliberate spawn of the same brief later gets a new one.
request_id() { # $1 = spawn | merge, then what names the call
  local what="$1" h; shift
  h=$(printf '%s\n' "$@" | { shasum -a 256 2>/dev/null || sha256sum 2>/dev/null || cksum; } | awk '{print $1}' | cut -c1-16)
  echo "nayo-$what-$h"
}

# Superset's CLI takes no request id, so spawn keeps its own ledger: $STATE/requests/<id>
# holds the session a request started, for 24 hours, and a retry finds it there.
ledger_get() { # $1 = request id; prints its session id, fails when there's none
  local f="$STATE/requests/$1"
  [ -s "$f" ] && [ $(( $(now) - $(mtime "$f") )) -lt 86400 ] && cat "$f"
}
ledger_put() { # $1 = request id, $2 = the session it started
  mkdir -p "$STATE/requests" && printf '%s\n' "$2" > "$STATE/requests/$1"
  find "$STATE/requests" -type f -mtime +1 -exec rm -f {} + 2>/dev/null
  return 0
}
# A retry's note, when brief $1's request already started session $2.
ledger_note() { echo "nayo: this spawn of $1 already started $(short "$2") (a retry): no second worker"; }

# brief_files (the globs a brief may touch) is with the merge checks below.

# Whether path-or-glob $1 and $2 can name the same file: equal, one a folder holding the
# other, one a glob matching the other, or (both globs) one's fixed start inside the other's.
paths_overlap() {
  local a="$1" b="$2" pa pb
  [ "$a" = "$b" ] && return 0
  case "$b" in "$a"/*) return 0 ;; esac
  case "$a" in "$b"/*) return 0 ;; esac
  # shellcheck disable=SC2254
  case "$b" in $a) return 0 ;; esac
  # shellcheck disable=SC2254
  case "$a" in $b) return 0 ;; esac
  pa=${a%%[*?[]*}; pb=${b%%[*?[]*}
  if [ "$pa" != "$a" ] && [ "$pb" != "$b" ]; then
    case "$pa" in "$pb"*) return 0 ;; esac
    case "$pb" in "$pa"*) return 0 ;; esac
  fi
  return 1
}

# For a non-isolated brief $1: one "<running brief>: <its path> ↔ <ours>" line per overlap
# with the File scope of a non-isolated worker under Running workers in OPEN.md (spawned and not
# yet merged, so its edits are still loose in this checkout). Briefs without one are skipped.
files_overlaps() {
  local mine theirs other a b
  mine=$(brief_files "$1")
  [ -n "$mine" ] && [ -f "$OPEN" ] || return 0
  awk '/^## /{on = ($0 ~ /^## Running workers/); next} on && /^- / && !/ · isolate: /' "$OPEN" \
    | sed -n 's/.* · term [^ ]* · \([^ ]*\).*/\1/p' | sort -u | while read -r other; do
      set -f  # the globs are patterns here, not to expand
      [ "$other" = "$1" ] && continue
      [ -f "$other" ] || continue
      case "$(iso_path "$other")" in ""|no) ;; *) continue ;; esac
      theirs=$(brief_files "$other")
      [ -n "$theirs" ] || continue
      for a in $theirs; do
        for b in $mine; do
          paths_overlap "$a" "$b" && echo "$other: $a ↔ $b"
        done
      done
    done
}

# Spawn's refusal: brief $1 (not isolated) shares files with a running worker; $2 = force.
check_files() {
  local hits
  hits=$(files_overlaps "$1")
  [ -n "$hits" ] || return 0
  echo "nayo: $1 expects to touch files a running worker in this checkout also does:" >&2
  printf '%s\n' "$hits" | head -n 12 | sed 's/^/  /' >&2
  [ "$2" = 1 ] && { echo "  spawning anyway (--force)" >&2; return 0; }
  die "isolate one of them (--isolate, or isolate: yes), wait for that worker's merge, or --force"
}

cmd_spawn() {
  local brief="" after="" follow="" why="" force=0 worker model effort tier prompt out id b cap_now account
  local iso=0 dry=0 defmodel="" rid
  while [ $# -gt 0 ]; do
    case "$1" in
      --after|--redo)
        [ -z "$follow" ] || die "give --after or --redo, not both"
        follow=${1#--}; after="${2:-}"; shift 2 ;;
      --why)
        [ $# -ge 2 ] && [ -n "$2" ] || die "--why needs a one-line reason"
        why=$(printf '%s' "$2" | tr '\n' ' '); shift 2 ;;
      --force) force=1; shift ;;
      --isolate) iso=1; shift ;;
      --no-terminal) dry=1; shift ;;
      *) brief="$1"; shift ;;
    esac
  done
  [ -f "$brief" ] || die "usage: nayo spawn <handoffs/briefs/file.md> [--after <handoff> | --redo <handoff> [--why \"<line>\"]] [--force] [--isolate [--no-terminal]]"
  [ -z "$why" ] || [ "$follow" = redo ] || die "--why goes with --redo"
  # Before anything rewrites the brief: a retry of this spawn gets the same id.
  rid=$(request_id spawn "$brief" "$(field started "$brief")" "$follow" "$after")
  # isolate: yes (a new worktree) or isolate: <path> · branch: <b> (that worktree again: a redo, a merge brief)
  case "$(iso_path "$brief")" in ""|no) ;; *) iso=1 ;; esac
  [ "${NAYO_DRY:-0}" = 1 ] && dry=1
  [ $dry = 0 ] || [ $iso = 1 ] || die "--no-terminal (NAYO_DRY=1) goes with --isolate"
  have jq || die "jq is needed to read the spawn result"
  [ -n "$WS" ] || [ $dry = 1 ] || die "SUPERSET_WORKSPACE_ID not set"

  worker=$(field worker "$brief" | awk '{print $1}')
  model=$(field model "$brief" | awk '{print $1}')
  effort=$(field effort "$brief" | awk '{print $1}')
  case "$worker" in claude|codex|opencode|grok) ;; *) die "brief header needs worker: claude | codex | opencode | grok" ;; esac
  # a Claude brief with no model or effort of its own takes the user's defaults; one that
  # names another model says why in brackets, model: claude-opus-5-5 (cross-crate design)
  if [ "$worker" = claude ]; then
    defmodel=$(worker_default model)
    model_default_note "$(field model "$brief")" "$defmodel"
    case "$model" in \<*|""|default) model=$defmodel ;; esac
    case "$effort" in \<*|""|default) effort=$(worker_default effort) ;; esac
  fi
  case "$model" in \<*|"") [ "$worker" = opencode ] || [ "$worker" = grok ] || die "brief header needs a model (or set a default: araniko settings set workers.model <model>)" ;; esac
  case "$model" in fable) tier=top ;; claude-opus-5-5|opus) tier=workhorse ;; *) tier=other ;; esac

  # An older "From to-do:" line (Open tab, before Tasks:) still links; an empty one is ignored.
  if grep -q '^From to-do:' "$brief"; then
    ft=$(grep -m1 '^From to-do:' "$brief" | sed 's/^From to-do:[[:space:]]*//')
    case "$ft" in ""|\<*) ;; *) echo "linked to to-do: $ft (older From to-do: line; Tasks: links it now)" ;; esac
  fi

  # Tasks: line (or an older Asks:) — refuses a malformed, unknown, skipped or removed
  # id, warns when it's missing.
  check_asks "$brief" "$force"
  owner_brief_warn "$brief"
  open_seed

  # Before the lint, which fails a UI brief without the section.
  stamp_knowledge "$brief"   # the project of this checkout, by araniko project get
  check_notes "$brief"

  if [ -x "$BIN/jev.sh" ]; then
    "$BIN/jev.sh" brief "$brief" || [ $force = 1 ] || die "sharpen the brief (or --force if the lint is wrong)"
  fi
  # files: shared with a running worker in this checkout
  [ $iso = 1 ] || check_files "$brief" "$force"

  b=$(band | cut -f1)
  if [ "$worker" = claude ] && [ $force = 0 ] && { [ -z "$(field account "$brief" | awk '{print $1}')" ] || [ "$(field account "$brief" | awk '{print $1}')" = 1 ]; }; then
    [ "$model" = fable ] && { [ "$b" = amber ] || [ "$b" = red ]; } && die "band is $b: fable is off for workers. Use model: claude-opus-5-5 ($b band; fable-tier task), or --force"
    cap_now=$(claude_sessions)
    if [ "$cap_now" -ge "$NAYO_MAX_CLAUDE" ]; then
      die "Claude cap reached ($cap_now of $NAYO_MAX_CLAUDE, Nayo included). Queue it under To-do in $OPEN, route it to OpenCode/Codex, or --force"
    fi
  fi

  # The brief and the worker rules go inline (worker_prompt), so the worker doesn't open them.
  prompt="$(worker_prompt "$brief" "$after" "$brief" "$after" "$worker")"$'\n\n'
  [ "$worker" = opencode ] && prompt="${prompt}Touch only the files it lists. Never run git commands that change state. "
  prompt="${prompt}Put every question in one first handoff (status: blocked); once answered, finish this brief and hand off.$(owner_prompt)"
  prompt="$prompt$(lessons_block "$brief")"

  if [ $iso = 1 ]; then
    spawn_isolated
    return
  fi

  set -- --workspace "$WS" --agent "$worker" --prompt "$prompt" --json
  case "$worker" in
    opencode|grok) [ -n "$model" ] && case "$model" in \<*) ;; *) set -- "$@" --model "$model" ;; esac ;;
    *) set -- "$@" --model "$model"; [ -n "$effort" ] && set -- "$@" --effort "$effort" ;;
  esac
  account=$(field account "$brief" | awk '{print $1}')
  if [ "$worker" = claude ] && [ -n "$account" ] && [ "$account" != 1 ]; then
    # Another Claude Code login (CLAUDE_CONFIG_DIR=~/.claude-<n>): Superset's agent presets
    # can't pick an account, so run the CLI in a plain terminal the same way the preset does.
    [ -d "$HOME/.claude-$account" ] || die "no ~/.claude-$account: log that account in first (CLAUDE_CONFIG_DIR=~/.claude-$account claude, then /login)"
    local cmd="CLAUDE_CONFIG_DIR=\$HOME/.claude-$account claude --dangerously-skip-permissions --model $model${effort:+ --effort $effort} $(printf '%q' "$prompt")"
    if id=$(ledger_get "$rid"); then ledger_note "$brief" "$id"; else
    out=$(superset terminals create --workspace "$WS" --command "$cmd" --json 2>&1) || die "spawn on account $account failed: $out"
    id=$(printf '%s' "$out" | jq -r '.terminalId // empty' 2>/dev/null)
    fi
    effort="${effort:+$effort }acct $account"
  elif id=$(ledger_get "$rid"); then ledger_note "$brief" "$id"
  else
  out=$(superset agents create "$@" 2>&1) || die "spawn failed (a failed Claude spawn means the red band): $out"
  id=$(printf '%s' "$out" | jq -r '.sessionId // empty' 2>/dev/null)
  fi
  [ -n "$id" ] || die "no sessionId in: $out"
  ledger_put "$rid" "$id"

  set_started "$brief" "$id" || echo "nayo: couldn't record started: in $brief" >&2
  brief_follows "$brief" "$follow" "$after" "$why" || echo "nayo: couldn't record ${follow:-follow} in $brief (no started: line?)" >&2
  open_add_running "- $(date '+%Y-%m-%d %H:%M') · $worker/${model:-default}${effort:+ $effort} · term $id · $brief"
  echo "spawned $(short "$id")${ASKS:+ · $ASKS ·} $worker/${model:-default}${effort:+ $effort} ← $brief (Claude sessions $(claude_sessions) of $NAYO_MAX_CLAUDE)"
}

# ---------------------------------------------------------------- brief scope and acceptance
# A brief's ## File scope (globs) and ## Acceptance (one command), checked before a merge.
# A brief without both is an older one: merge skips these checks with one line.

# The body of brief $2's "## $1" section, up to the next heading; one-line HTML comments dropped.
brief_section() {
  awk -v want="## $1" '/^## /{sub(/[[:space:]]+$/, ""); on = ($0 == want); next} on' "$2" 2>/dev/null \
    | grep -v '^[[:space:]]*<!--.*-->[[:space:]]*$'
}

# The globs brief $1 may touch, one per line: its ## File scope section (bullets or commas;
# a ` — note` after a glob is dropped), else the older files: header line. A <placeholder> names none.
brief_files() {
  local v
  v=$(brief_section 'File scope' "$1" | sed -E -e 's/^[[:space:]]*[-*][[:space:]]+//' \
        -e 's/[[:space:]]+(—|–|--|-|\().*$//' | grep -v '^[[:space:]]*<')
  if [ -z "$v" ]; then
    v=$(field files "$1")
    case "$v" in ""|\<*) return 0 ;; esac
  fi
  printf '%s\n' "$v" | tr ',' ' ' | tr -s ' \t' '\n\n' | sed -e 's/`//g' -e 's#^\./##' -e 's#/$##' | grep -v '^$'
}

# Brief $1's File scope as one anchored extended regex: `**` spans folders, `*` and `?` stay
# within one, and a plain path also covers everything under it.
scope_regex() {
  brief_files "$1" | awk '
    { g = $0; plain = (g !~ /[*?[]/)
      gsub(/[.+(){}|^$\\]/, "\\\\&", g)
      gsub(/\*\*\//, "\001", g); gsub(/\*\*/, "\002", g)
      gsub(/\*/, "[^/]*", g); gsub(/\?/, "[^/]", g)
      gsub(/\001/, "(.*/)?", g); gsub(/\002/, ".*", g)
      r = r (r == "" ? "" : "|") g (plain ? "(/.*)?" : "") }
    END { if (r != "") print "^(" r ")$" }'
}

# The paths on stdin outside brief $1's File scope; the brief and the worker's handoff ($2)
# are always in it.
outside_scope() {
  local re
  re=$(scope_regex "$1")
  [ -n "$re" ] || { cat > /dev/null; return 0; }
  grep -Ev "$re" | grep -vxF -e "$1" -e "${2:-$1}" | grep -v '^$'
}

# Brief $1's Acceptance command: the first line of its ## Acceptance section (the command
# inside a leading pair of backticks), or the lines of a ``` block there. A <placeholder> is none.
brief_acceptance() {
  brief_section Acceptance "$1" | awk '
    /^[[:space:]]*```/ { if (fence) exit; fence = 1; next }
    fence { print; next }
    NF { print; exit }' | sed -E '1s/^[[:space:]]*`([^`]*)`.*$/\1/' | awk 'NR == 1 && /^[[:space:]]*</ {exit} {print}'
}

# Whether brief $1 has both: a File scope and an Acceptance command.
brief_checked() {
  [ -n "$1" ] && [ -f "$1" ] && [ -n "$(brief_files "$1")" ] && [ -n "$(brief_acceptance "$1")" ]
}

kill_tree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done; kill -TERM "$1" 2>/dev/null; }

# Runs command $2 with bash -c in folder $1, its output in file $3, for at most
# NAYO_ACCEPTANCE_TIMEOUT seconds (900). Returns its exit code, 124 when it timed out and 130
# when Ctrl-C cancelled it; either way it and everything it started are stopped.
run_acceptance() {
  local pid dog mark="$3.timeout" rc=0 cancelled=0
  rm -f "$mark"
  ( cd "$1" && exec bash -c "$2" ) > "$3" 2>&1 < /dev/null &
  pid=$!
  ( sleep "${NAYO_ACCEPTANCE_TIMEOUT:-900}"; : > "$mark"; kill_tree "$pid" ) > /dev/null 2>&1 &
  dog=$!
  # background jobs ignore Ctrl-C here, so the trap stops the command
  trap 'cancelled=1; kill_tree "$pid"' INT TERM
  while :; do wait "$pid"; rc=$?; kill -0 "$pid" 2>/dev/null || break; done
  trap - INT TERM
  kill_tree "$dog"; wait "$dog" 2>/dev/null
  [ $cancelled = 1 ] && { rm -f "$mark"; return 130; }
  [ -f "$mark" ] && { rm -f "$mark"; return 124; }
  return $rc
}

# Replaces handoff $1's "## $2" section with $3 (a section only written when $4 = new), at the end.
handoff_section() {
  local tmp
  [ -f "$1" ] || return 0
  grep -qxF "## $2" "$1" || [ "${4:-}" = new ] || return 0
  tmp=$(mktemp "$1.XXXXXX") || return 0
  { awk -v h="## $2" '/^## /{skip = ($0 == h)} !skip' "$1" \
      | awk 'NF {while (b > 0) {print ""; b--} print; next} {b++}'
    printf '\n## %s\n%s\n' "$2" "$3"; } > "$tmp" && mv "$tmp" "$1" || rm -f "$tmp"
}

# merge_checks' part for a brief with File scope and Acceptance (brief $1, handoff $2,
# worktree $3, empty for this checkout). In this checkout, a handoff that lists files outside
# the scope is red (an isolated branch's are put back by merge_isolated instead). Then the
# Acceptance command runs there; a fail or timeout is red and (not with --check) goes into
# the handoff with its last 20 lines. Sets red and red_why (cmd_merge's locals); Ctrl-C exits 130.
scope_acceptance_checks() {
  local cmd out log rc t0 secs why="" limit="${NAYO_ACCEPTANCE_TIMEOUT:-900}"
  if ! brief_checked "$1"; then
    echo "  checks: brief has no Acceptance/File scope (older brief), skipped"
    return 0
  fi
  if [ -z "${3:-}" ]; then
    out=$(printf '%s\n' $files | outside_scope "$1" "$2")
    if [ -n "$out" ]; then
      echo "  ✗ scope: the handoff lists files outside the brief's File scope:"
      printf '%s\n' "$out" | sed 's/^/    /'
      red=1; red_why="${red_why:+$red_why; }the handoff lists files outside the brief's File scope ($(printf '%s ' $out | sed 's/ $//'))"
    else
      echo "  scope: every listed file is inside the File scope"
    fi
  fi
  cmd=$(brief_acceptance "$1")
  if [ "${status:-}" = blocked ]; then echo "  acceptance: not run (status: blocked)"; return 0; fi
  if [ $red = 1 ] && [ -z "${anyway:-}" ]; then echo "  acceptance: not run (already red)"; return 0; fi
  log=$(mktemp "${TMPDIR:-/tmp}/nayo-acceptance.XXXXXX") || die "mktemp failed"
  echo "  acceptance: running \`$cmd\` in ${3:-this checkout} (timeout ${limit}s; Ctrl-C cancels)"
  t0=$(now)
  run_acceptance "${3:-$ROOT}" "$cmd" "$log"; rc=$?
  secs=$(( $(now) - t0 ))
  case $rc in
    0) ;;
    130) rm -f "$log"; echo "nayo: acceptance cancelled (Ctrl-C), not merged" >&2; exit 130 ;;
    124) why="timed out after ${limit}s" ;;
    *) why="failed (exit $rc)" ;;
  esac
  if [ -z "$why" ]; then
    echo "  acceptance: passed (${secs}s)"
    [ "${check:-0}" = 1 ] ||
      handoff_section "$2" "Acceptance (run by nayo merge)" "Passed · ${secs}s · $(date '+%Y-%m-%d %H:%M') · \`$cmd\`"
  else
    echo "  ✗ acceptance: $why · \`$cmd\` · last lines:"
    tail -n 20 "$log" | sed $'s/\x1b\\[[0-9;?]*[A-Za-z]//g; s/^/    /'
    [ "${check:-0}" = 1 ] ||
      handoff_section "$2" "Acceptance (run by nayo merge)" "$(printf 'Failed: %s · %ss · %s · `%s` (in %s)\n\n```\n%s\n```' \
      "$why" "$secs" "$(date '+%Y-%m-%d %H:%M')" "$cmd" "${3:-the shared checkout}" \
      "$(tail -n 20 "$log" | sed $'s/\x1b\\[[0-9;?]*[A-Za-z]//g')")" new
    red=1; red_why="${red_why:+$red_why; }the Acceptance command $why"
  fi
  rm -f "$log"
}

# The paths isolated worktree $3 changed since $4 (committed, uncommitted, untracked;
# deletions and both sides of renames) outside brief $1's File scope; handoff $2 exempt.
iso_outside() {
  { git -C "$3" diff --name-only --no-renames "$4" -- 2>/dev/null
    git -C "$3" ls-files --others --exclude-standard 2>/dev/null; } | sort -u | outside_scope "$1" "$2"
}

# Before an isolated merge (brief $1, handoff $2, worktree $3, branch point $4, branch $5):
# every change outside the File scope goes back to the branch point, committed on the
# branch. The changes are saved first as a patch in handoffs/.nayo/putback/, and the put-back
# paths are listed in the handoff. Prints the paths it put back.
iso_put_back() {
  local out f undo patch
  out=$(iso_outside "$1" "$2" "$3" "$4")
  [ -n "$out" ] || return 0
  for f in $out; do git -C "$3" add -A -- "$f" >/dev/null 2>&1; done
  mkdir -p "$H/.nayo/putback"
  patch="$H/.nayo/putback/$(basename "$2" .md)-$(date +%Y%m%d-%H%M%S).patch"
  git -C "$3" diff --cached --binary "$4" -- $out > "$patch" 2>/dev/null
  for f in $out; do
    if git -C "$3" cat-file -e "$4:$f" 2>/dev/null; then
      git -C "$3" checkout -q "$4" -- "$f" || die "couldn't put back $f in $3"
    else
      git -C "$3" rm -q -f --ignore-unmatch -- "$f" >/dev/null || die "couldn't put back $f in $3"
      rm -f "$3/$f"
    fi
  done
  undo=$(git -C "$3" diff --cached --name-only -- $out)
  if [ -n "$undo" ]; then
    git -C "$3" commit -q -m "Put back changes outside the brief's File scope" \
      -m "$(printf '%s\n' $out)" -- $undo || die "committing the put-back on $5 failed"
  fi
  [ -z "$(iso_outside "$1" "$2" "$3" "$4")" ] || die "files outside the File scope are still changed in $3 after the put-back"
  handoff_section "$2" "Scope (put back by nayo merge)" "$(printf 'Outside the File scope, put back on %s (the changes are saved in %s):\n' "$5" "$patch"; printf -- '- %s\n' $out)" new
  printf '%s\n' "$out"
}

# ---------------------------------------------------------------- merge

listed_files() { # the paths under "## Files" in a handoff
  awk '/^## /{on = ($0 ~ /^## Files/); next} on && /^[[:space:]]*[-*] /' "$1" \
    | sed -E -e 's/^[[:space:]]*[-*][[:space:]]+//' -e 's/`//g' \
             -e 's/[[:space:]]+(—|–|--|-|\().*$//' -e 's/[[:space:]]+$//' -e 's/[,;]+$//' \
    | grep -v '^path/relative' | grep -v '^$'
}

changed_paths() { # every changed/untracked path, renames as their new path
  git status --porcelain -uall 2>/dev/null | cut -c4- | sed -e 's/.* -> //' -e 's/^"//' -e 's/"$//'
}

# The brief's "## Checks" section says `none`: checks don't apply to its work.
checks_none() {
  [ -f "$1" ] || return 1
  awk '/^## /{on = ($0 ~ /^## Checks[[:space:]]*$/); next} on && NF {print; exit}' "$1" \
    | tr -d '`' | tr 'A-Z' 'a-z' | grep -qE '^[[:space:]]*none([^a-z0-9]|$)'
}

# Araniko's own run of the checks on handoff $1 (the daemon runs them once the worker hands
# off and writes a `## Checks (run by Araniko)` section into it): "queued" or "running"
# while one is coming (`araniko check --handoff`; skipped without jq or araniko), else
# "passed" or "failed <checks>" from the section, else nothing.
araniko_checks() {
  local state first
  if have jq && have araniko; then
    state=$(araniko check --handoff "$1" --json 2>/dev/null | jq -r '
      if type == "object" and (.state == "queued" or .state == "running") then .state else empty end' 2>/dev/null)
    [ -n "$state" ] && { echo "$state"; return 0; }
  fi
  first=$(awk '/^## /{on = ($0 ~ /^## Checks \(run by Araniko\)[[:space:]]*$/); next} on && NF {print; exit}' "$1" 2>/dev/null)
  case "$first" in
    Passed*) echo passed ;;
    Failed*) echo "failed $(printf '%s' "$first" | sed -E 's/^Failed:?[[:space:]]*//; s/[[:space:]]+·.*$//')" ;;
  esac
}

# Araniko's run on handoff $1, for merge: prints its line and sets red=1 and red_why
# (cmd_merge's locals) when it failed or hasn't finished; returns 1 when there's none.
merge_araniko_checks() {
  local u
  u=$(araniko_checks "$1")
  case "$u" in
    passed) echo "  checks: passed (Araniko ran them on the handoff)" ;;
    failed*) echo "  ✗ checks: failed (Araniko ran them on the handoff) — ${u#failed }"; red=1; red_why="checks are red (${u#failed })" ;;
    queued|running) echo "  ✗ checks: Araniko is still running them on the handoff"; red=1; red_why="Araniko's checks on this handoff haven't finished — wait for its next handoff.written (the result lands in the handoff)" ;;
    *) return 1 ;;
  esac
  return 0
}

# Before anything changes: refuse while red is set, unless --anyway "<reason>" was given.
checks_gate() {
  [ $red = 1 ] && [ -z "$anyway" ] && die "$red_why — send it back to fix them, or --anyway \"<reason>\" (a brief whose ## Checks says \`none\` skips this)"
  return 0
}

# After the other gates: --anyway "<reason>" is logged in the handoff ($1), like
# --skip-second-opinion's.
checks_anyway_log() {
  [ -n "$anyway" ] || return 0
  grep -qF "Merged anyway: $anyway" "$1" 2>/dev/null ||
    printf '\n## Checks override\nMerged anyway: %s (%s)\n' "$anyway" "$(date '+%Y-%m-%d %H:%M')" >> "$1"
  echo "  checks overridden: $anyway (logged in the handoff)"
}

# Print the checks line for merge (brief $1, handoff $2): Araniko's run on the handoff, when
# the project's daemon ran one; sets red=1 and red_why (cmd_merge's locals) when it's red.
merge_checks() {
  if checks_none "$1"; then
    echo "  checks: none (the brief's ## Checks says so)"
  else
    merge_araniko_checks "$2" || true
  fi
  scope_acceptance_checks "$1" "$2" "${3:-}"
}

# A second opinion (`araniko review second`): the project's policy (Project settings →
# "Second opinion before merging": off, on big changes, always) may want one before
# merging. Prints its line and sets so_block (cmd_merge's local) when the merge must
# wait: one is needed and there's none, or it's stale, running or failed; or its
# verdict is Blocking. Fails open: no jq, no araniko, or an araniko without it says nothing.
second_opinion() {
  local v state needed reason review
  have jq && have araniko || return 0
  v=$(araniko review second "$1" --status --json 2>/dev/null) || return 0
  state=$(printf '%s' "$v" | jq -r '.state // empty' 2>/dev/null)
  [ -n "$state" ] || return 0
  needed=$(printf '%s' "$v" | jq -r '.policy.needed // false')
  reason=$(printf '%s' "$v" | jq -r '.policy.reason // ""')
  review=$(printf '%s' "$v" | jq -r '.review // ""')
  if [ "$state" = done ]; then
    echo "  second opinion: $(printf '%s' "$v" | jq -r '.verdict_text // "no verdict"') · $review"
    [ "$(printf '%s' "$v" | jq -r '.verdict // ""')" = blocking ] && so_block="the second opinion is Blocking ($review)"
    return 0
  fi
  case "$state" in
    stale) echo "  second opinion: stale, the handoff changed after it · $review" ;;
    running) echo "  second opinion: still running" ;;
    failed) echo "  second opinion: failed — $(printf '%s' "$v" | jq -r '.error // ""')" ;;
    *) echo "  second opinion: none" ;;
  esac
  if [ "$needed" = true ]; then
    echo "  ✗ the project wants one before merging: $reason"
    so_block="this handoff needs a second opinion first ($reason)"
  else
    echo "    not needed: $reason"
  fi
}

# After second_opinion, before anything changes: refuse while so_block is set, unless
# --skip-second-opinion "<reason>" was given, which is logged in the handoff ($1).
second_opinion_gate() {
  if [ -n "$skip_so" ]; then
    grep -qF "Skipped at merge: $skip_so" "$1" 2>/dev/null ||
      printf '\n## Second opinion\nSkipped at merge: %s (%s)\n' "$skip_so" "$(date '+%Y-%m-%d %H:%M')" >> "$1"
    echo "  second opinion skipped: $skip_so (logged in the handoff)"
  elif [ -n "$so_block" ]; then
    die "$so_block — run \`araniko review second $1\`, send Blocking findings back to a worker, or --skip-second-opinion \"<reason>\""
  fi
}

# ---------------------------------------------------------------- merge --check --verify
# The brief's ```bash verify``` blocks (under ## Checks) on HEAD plus exactly handoff $1's
# listed changes, in a detached worktree under handoffs/.nayo/verify/ that is always removed;
# $2/$3 = an isolated worker's worktree and its branch point, where the changes are.
# nayo-verify.py does the work; uses cmd_merge's locals verify and reuse. Exits with the
# verifier's code when it isn't 0 (1 failed, 2 setup, 75 rerun later, 124 timeout).
verify_run() {
  [ "${verify:-0}" = 1 ] || return 0
  local d py rc age="${NAYO_REUSE_MAX_AGE:-7200}"
  have python3 || die "--verify needs python3, and there's none on PATH (nothing run)"
  case "$age" in ""|*[!0-9]*) die "NAYO_REUSE_MAX_AGE takes whole seconds (0 = never reuse), not '$age'" ;; esac
  d=$(cd "$(dirname "$0")" 2>/dev/null && pwd) && [ -f "$d/nayo-verify.py" ] || d="$ROOT/$H/bin"
  py="$d/nayo-verify.py"
  [ -f "$py" ] || die "no $py — update the Nayo kit (nothing run)"
  echo "  verify: running the brief's verify blocks in a worktree of HEAD + the listed changes (Ctrl-C cancels)"
  python3 -I "$py" --root "$ROOT" --handoff "$1" --runner "$d/$(basename "$0")" --bash "$BASH" \
    ${2:+--source "$2" --base "$3"} --reuse="${reuse:-0}" --max-age "$age" \
    --max-sec "${NAYO_VERIFY_MAX_SEC:-7200}" --lock-wait "${NAYO_LOCK_WAIT:-3600}" \
    --grace "${NAYO_STOP_GRACE:-10}" --reuse-env "${NAYO_REUSE_ENV:-}"
  rc=$?
  [ $rc = 0 ] || exit $rc
}

cmd_merge() {
  local ho="" check=0 msg="" outcome="" push="$NAYO_PUSH" keep=0 force=0 so_block="" skip_so="" rv=""
  local verify=0 reuse=0
  local anyway="" red=0 red_why=""
  local status brief agent files f bad=0 other title dest trailer sha term old_tracked=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      --verify) verify=1; shift ;;
      --reuse) reuse=1; shift ;;
      -m) msg="${2:-}"; shift 2 ;;
      --outcome) outcome="${2:-}"; shift 2 ;;
      --no-push) push=0; shift ;;
      --keep-open) keep=1; shift ;;
      --force) force=1; shift ;;
      --skip-second-opinion) skip_so="${2:-}"; [ -n "$skip_so" ] || die "--skip-second-opinion needs a reason"; shift 2 ;;
      --anyway) anyway="${2:-}"; [ -n "$anyway" ] || die "--anyway needs a reason"; shift 2 ;;
      *) ho="$1"; shift ;;
    esac
  done
  [ $verify = 0 ] || [ $check = 1 ] || die "--verify goes with --check: nayo merge <handoff> --check --verify [--reuse]"
  [ $reuse = 0 ] || [ $verify = 1 ] || die "--reuse goes with --check --verify"
  [ -f "$ho" ] || die "usage: nayo merge <handoffs/file.md> [--check [--verify [--reuse]]] [-m msg] [--outcome clean|corrected|escalated|respawned] [--no-push] [--keep-open]"
  status=$(field status "$ho" | awk '{print $1}')
  brief=$(field brief "$ho" | awk '{print $1}')
  agent=$(field agent "$ho")
  files=$(listed_files "$ho" | grep -vxF "$ho")  # a handoff that lists itself is moved, not added
  [ -n "$files" ] || die "$ho lists no files under ## Files"

  # an isolated worker's handoff: its branch is committed in its worktree and git-merged here
  if [ -n "$brief" ] && [ -f "$brief" ]; then
    case "$(iso_path "$brief")" in ""|no|yes) ;; *) merge_isolated; return ;; esac
  fi

  echo "$ho · status: $status · brief: ${brief:-none}"
  for f in $files; do
    if changed_paths | grep -qxF "$f"; then :; else
      echo "  ✗ listed but not changed: $f"; bad=1
    fi
  done
  other=$(changed_paths | grep -v "^$H/" | grep -vxF "$files")
  if [ -n "$other" ]; then
    echo "  other changes in the checkout (another worker's, or missing from this list):"
    printf '%s\n' "$other" | head -n 12 | sed 's/^/    /'
  fi
  git diff --stat -- $files 2>/dev/null | sed 's/^/  /'
  for f in $files; do
    git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 || [ ! -f "$f" ] || echo "   new: $f ($(wc -l < "$f" | tr -d ' ') lines)"
  done
  merge_checks "$brief" "$ho"
  second_opinion "$ho"
  [ $check = 1 ] && { verify_run "$ho"; [ -z "$so_block" ] || exit 1; exit $((bad | red)); }

  [ "$status" = blocked ] && die "status is blocked — answer its questions first"
  checks_gate
  [ $bad = 1 ] && [ $force = 0 ] && die "file list doesn't match git status — send it back, or --force"
  second_opinion_gate "$ho"
  team_guard "$push"
  checks_anyway_log "$ho"

  mkdir -p "$H/merged"
  dest="$H/merged/$(owner_name "$(basename "$ho")")"
  term=$(sed -n 's/.*terminal:[[:space:]]*\([^ ]*\).*/\1/p' "$brief" 2>/dev/null | head -n 1)
  case "$term" in ""|\<*) term="" ;; esac
  [ -n "$brief" ] && open_drop "$brief"
  open_drop "$(basename "$ho")"
  git ls-files --error-unmatch -- "$ho" >/dev/null 2>&1 && old_tracked=1
  mv "$ho" "$dest"
  set -- $files "$dest"
  rv="$H/reviews/$(basename "$ho" .md)-second.md"; [ -f "$rv" ] && set -- "$@" "$rv"
  [ $old_tracked = 1 ] && set -- "$@" "$ho"
  [ -n "$brief" ] && [ -f "$brief" ] && set -- "$@" "$brief"
  [ -f "$OPEN" ] && set -- "$@" "$OPEN"
  # a path the worker already `git rm`-ed is in neither the tree nor the index: its deletion is staged, and `git add` would fail on it
  for f; do { [ -e "$f" ] || git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; } || continue; git add -A -- "$f" || die "git add failed: $f"; done

  title=$(sed -n '1s/^#[[:space:]]*//p' "$dest")
  [ -n "$msg" ] || msg="$title"
  trailer=""
  case "$agent" in
    claude*) trailer="Co-Authored-By: Claude Code <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
    codex*) trailer="Co-Authored-By: Codex <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
    opencode*) trailer="Co-Authored-By: OpenCode <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
    grok*) trailer="Co-Authored-By: Grok <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
  esac
  if [ -n "$trailer" ]; then
    git commit -q -m "$msg" -m "$trailer" -- "$@" || die "commit failed"
  else
    git commit -q -m "$msg" -- "$@" || die "commit failed"
  fi
  sha=$(git rev-parse --short HEAD)
  line="merged $sha · $(printf '%s\n' $files | wc -l | tr -d ' ') files"

  if [ "$push" = 1 ]; then
    if [ -n "$TEAM_CONF" ]; then
      line="$line · $(team_push)"
    elif git push -q 2>/dev/null; then line="$line · pushed"; else line="$line · push FAILED (run git push)"; fi
  fi
  if [ $keep = 0 ] && [ -n "$term" ] && [ -n "$WS" ]; then
    superset terminals close --workspace "$WS" --terminal "$term" >/dev/null 2>&1 && line="$line · closed $(short "$term")"
  fi
  if [ -n "$outcome" ] && [ -x "$BIN/jev.sh" ] && [ -n "$brief" ]; then
    "$BIN/jev.sh" outcome "$brief" "$outcome" >/dev/null 2>&1
  fi
  echo "$line · $(basename "$OPEN") updated in the same commit"
  return 0
}

# ---------------------------------------------------------------- isolated workers

# A brief with `isolate: yes` (or spawned with --isolate) runs in its own git worktree
# at $WT_ROOT/<repo>/<slug>, on branch jw/<slug> from HEAD; spawn rewrites the line to
# `isolate: <worktree> · branch: jw/<slug>`, and merge reads it back. The worker edits
# and builds only there and writes its handoff into this checkout's handoffs/, so
# `nayo events` sees it. Merge commits the listed files on the branch inside the
# worktree, then `git merge --no-ff`s the branch here. --no-ff rather than rebase +
# fast-forward: a conflict is resolved by merging the main branch INTO jw/<slug>, and a
# rebase would replay the original commits and hit the same conflict again. The merge
# is tried first with `git merge-tree` (no working tree), so a conflict never touches
# this checkout; it writes a merge brief instead (see iso_conflict).

REPO_NAME=$(basename "$ROOT")

iso_slug() { basename "$1" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}-//'; }
iso_path() { field isolate "$1" | sed -E 's/[[:space:]]*·[[:space:]]*branch:.*$//; s/[[:space:]]+$//'; }
iso_branch() { field isolate "$1" | sed -n 's/.*branch:[[:space:]]*\([^ ]*\).*/\1/p'; }
# One cargo target per worktree: the workspace crates hash the same in every worktree, so a
# shared target let one worker's build overwrite another's (2026-11-10).
iso_target() { echo "$WT_ROOT/$REPO_NAME/target-$(basename "${ISO_WT:-shared}")"; }
# After worktree $1 is removed: delete its cargo targets, $(iso_target) and $(iso_target)-tauri
# (2-7 GB each; left behind they filled the disk on 2026-11-15). Only a target-<slug> folder
# directly under $WT_ROOT/$REPO_NAME, never the shared target.
iso_rm_targets() {
  local d="$WT_ROOT/$REPO_NAME" t ISO_WT=$1
  [ -n "$1" ] && [ -n "$(basename "$1")" ] || return 0
  for t in "$(iso_target)" "$(iso_target)-tauri"; do
    [ "$(dirname "$t")" = "$d" ] || continue
    case "$(basename "$t")" in target-?*) ;; *) continue ;; esac
    [ -d "$t" ] && rm -rf "$t"
  done
  return 0
}
# One line when the volume holding the worktrees has under 20 GB free (df only, no du: cheap).
disk_warn() {
  local d="$WT_ROOT" kb gb
  while [ ! -d "$d" ] && [ "$d" != / ]; do d=$(dirname "$d"); done
  kb=$(df -k "$d" 2>/dev/null | awk 'NR == 2 {print $4}')
  case "$kb" in ''|*[!0-9]*) return 0 ;; esac
  [ "$kb" -lt 20971520 ] || return 0
  gb=$((kb / 1048576))
  echo "disk: $gb GB free on the worktrees' volume — old target-* build folders in $WT_ROOT/$REPO_NAME are the usual cause"
}
iso_abs() { case "$1" in /*) echo "$1" ;; *) echo "$ROOT/$1" ;; esac; }

# Write `started: <now> · terminal: $2` into brief $1's header: over its started: line, or,
# when it has none, under effort: (else model:, else worker:), so follow and isolate:
# lines have their anchor.
set_started() {
  awk -v val="$(date '+%Y-%m-%d %H:%M') · terminal: $2" '
    /^## / { body = 1 }
    !body && /^started:/ { if (!done) line[++n] = "started: " val; done = 1; next }
    { line[++n] = $0; if (!body && /^effort:/) e = n; if (!body && /^model:/) m = n; if (!body && /^worker:/) w = n }
    END {
      at = done ? 0 : (e ? e : (m ? m : w))
      if (!done && !at) exit 3
      for (i = 1; i <= n; i++) { print line[i]; if (i == at) print "started: " val }
    }
  ' "$1" > "$1.tmp" || { rm -f "$1.tmp"; return 1; }
  mv "$1.tmp" "$1"
}

# Write `isolate: $2 · branch: $3` into brief $1's header, under started: (replacing one).
iso_header() {
  awk -v val="$2 · branch: $3" '
    /^## / { body = 1 }
    !body && /^isolate:/ { next }
    { print }
    !body && !done && /^started:/ { print "isolate: " val; done = 1 }
    END { if (!done) exit 3 }
  ' "$1" > "$1.tmp" || { rm -f "$1.tmp"; return 1; }
  mv "$1.tmp" "$1"
}

# The worktree for brief $1: the one its header names, else a new one. Sets ISO_WT, ISO_BR.
iso_prepare() {
  local brief=$1 v slug wt br n=2 real
  v=$(iso_path "$brief")
  if [ -n "$v" ] && [ "$v" != yes ]; then
    wt=$v; br=$(iso_branch "$brief")
    git -C "$wt" rev-parse --git-dir >/dev/null 2>&1 || die "isolate: $wt in $brief is not a worktree any more — set the line to 'isolate: yes' for a fresh one"
    [ -n "$br" ] || br=$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null)
    echo "isolated: reusing $wt ($br)"
  else
    slug=$(iso_slug "$brief"); [ -n "$slug" ] || die "no slug in $brief's name"
    case "$WT_ROOT/" in "$ROOT"/*) die "NAYO_WT_ROOT ($WT_ROOT) is inside the repo: Araniko would list the worktrees as branch Nayos" ;; esac
    mkdir -p "$WT_ROOT/$REPO_NAME" || die "can't create $WT_ROOT/$REPO_NAME"
    real=$(cd "$WT_ROOT/$REPO_NAME" && pwd -P)
    case "$real/" in
      "$(cd "$ROOT" && pwd -P)"/*) die "NAYO_WT_ROOT ($WT_ROOT) is inside the repo: Araniko would list the worktrees as branch Nayos" ;;
      "$(cd "${ARANIKO_HOME:-$HOME/.araniko}" 2>/dev/null && pwd -P || echo /nonexistent)"/*) die "NAYO_WT_ROOT ($WT_ROOT) is under ~/.araniko — put it somewhere else" ;;
    esac
    wt="$real/$slug"; br="jw/$slug"
    while [ -e "$wt" ] || git show-ref --verify --quiet "refs/heads/$br"; do
      wt="$real/$slug-$n"; br="jw/$slug-$n"; n=$((n + 1))
    done
    git worktree add -q -b "$br" "$wt" HEAD >/dev/null 2>&1 || die "git worktree add $wt failed"
    echo "isolated: new worktree $wt on $br from $(git rev-parse --short HEAD)"
  fi
  iso_links "$wt"
  ISO_WT=$wt; ISO_BR=$br
}

# The main checkout's node_modules folders (at the top and one folder down), linked into
# worktree $1 so nothing needs installing. Only where git ignores the link: a
# `node_modules/` pattern matches folders, not links, so the link would show as a change.
iso_links() {
  local d
  for d in node_modules */node_modules; do
    [ -d "$ROOT/$d" ] && [ -d "$1/$(dirname "$d")" ] && [ ! -e "$1/$d" ] && [ ! -L "$1/$d" ] || continue
    ln -s "$ROOT/$d" "$1/$d" || continue
    git -C "$1" check-ignore -q "$d" && continue
    rm -f "$1/$d"
    echo "isolated: didn't link $d: git doesn't ignore it as a link (add \`$d\` without a trailing slash to .gitignore)"
  done
}

# The shell command that starts agent $1 (model $2, effort $3, Claude account $4) on
# prompt $5, the way Superset's own preset for that agent does (`superset agents list`),
# plus CARGO_TARGET_DIR. `agents create` has no --cwd, so isolated workers go through
# `terminals create --cwd --command`, like the other-account path in cmd_spawn.
iso_command() {
  local worker=$1 model=$2 effort=$3 account=$4 prompt=$5 preset="" base pargs envs flags=""
  envs="CARGO_TARGET_DIR=$(printf '%q' "$(iso_target)")"
  if have superset && have jq; then
    preset=$(superset agents list --local --json 2>/dev/null | jq -r --arg p "$worker" '
      [.[]? | select(.presetId == $p)][0] // empty
      | ([.env // {} | to_entries[] | "\(.key)=\(.value | @sh)"] | join(" ")) + "\t"
        + ([.command] + (.args // []) | map(@sh) | join(" ")) + "\t"
        + ((.promptArgs // []) | map(@sh) | join(" "))' 2>/dev/null)
  fi
  if [ -n "$preset" ]; then
    [ -z "$(printf '%s' "$preset" | cut -f1)" ] || envs="$envs $(printf '%s' "$preset" | cut -f1)"
    base=$(printf '%s' "$preset" | cut -f2); pargs=$(printf '%s' "$preset" | cut -f3)
  else
    case "$worker" in # Superset's presets as of 2026-11-10
      claude) base="claude --dangerously-skip-permissions"; pargs="" ;;
      codex) base="codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust"; pargs="--" ;;
      opencode) base="opencode"; pargs="--prompt" ;;
      grok) base="grok --always-approve"; pargs="" ;;
    esac
  fi
  case "$worker" in
    claude)
      [ -n "$account" ] && [ "$account" != 1 ] && envs="$envs CLAUDE_CONFIG_DIR=\$HOME/.claude-$account"
      flags="--model $model${effort:+ --effort $effort}" ;;
    codex) flags="-m $model${effort:+ -c model_reasoning_effort=$effort}" ;;
    opencode|grok) case "$model" in ""|\<*) ;; *) flags="--model $model" ;; esac ;;
  esac
  printf '%s %s %s%s %q' "$envs" "$base" "$flags" "${pargs:+ $pargs}" "$prompt"
}

# The worker rules every spawned worker gets inline, condensed from AGENTS.md "Worker rules"
# and "When you finish a task". Keep it true to AGENTS.md (and the same in both kit scripts);
# project-specific bits stay in AGENTS.md and are pointed at, not copied.
worker_rules() {
  cat <<'EOF'
- Several workers share this checkout. Never commit, push, tag or open a PR, and never run git that changes state (stash, checkout --, restore, reset, clean, switch, worktree, rebase, merge): it reverts other workers' edits. Read-only git (status, diff, log, show, blame) is fine.
- The brief's ## File scope is a hard boundary: touch nothing outside it. Edit a shared file only minimally and name it in your handoff. Some things only Nayo does (dependencies, lockfiles, toolchains, releasing: `grep -n 'Only Nayo' AGENTS.md` for this project's list); write what's needed and flag it in your handoff.
- Your subagents follow these same rules: they read and summarise, never edit.
- Never ask the user anything or wait in the terminal. If you need rulings, put every question in your first handoff (status: blocked) and stop; start each with the brief's task, `1. (T-41) …`. Once the answers arrive, finish the brief without stopping again.
- Reading: grep -n first, then read line ranges (sed -n 'a,bp', or Read with offset/limit), at most ~150 lines at a time. Never cat or Read a whole file over 150 lines, nor a whole handoff or brief. Don't read the same lines twice; check your own edits with a test or grep -n. Pipe searches through head; from a build or test show only the failures. Read only the docs your brief names.
- Screenshots only to verify the finished result, once per screen. Never sleep-poll: run in the foreground with a timeout, or in the background and wait for its notification.
- Checks: scoped only. Run the brief's Acceptance command, the tests for what you touched and the linter/formatter on your own files; never the full suite or `araniko check` (Nayo runs those at merge). For this project's verification and checks, `grep -n 'Verification\|Checks:' AGENTS.md`.
- One brief, then hand off: do this brief's phase, write the handoff, stop. Write it for the next worker: what's done, what's left, where.
- The handoff is one file, handoffs/<YYYY-MM-DD-HHMM>-<short-slug>.md:
    # <one-line task title>
    status: done | blocked | partial
    agent: claude <model> | codex <model>
    brief: <this brief's path>
    ## What the user asked
    ## What changed            (behaviour, in plain words)
    ## Files                   (- path/relative/to/repo — created | modified | deleted; complete and exact: Nayo commits by it)
    ## Checks run              (what you ran, filtered; say plainly what you didn't check)
    ## Libraries used          (one line per library from the brief's Libraries and design rules you used or touched, or `none touched`)
    ## Questions for the user  (only when status: blocked; numbered, one line each)
    ## Notes for Nayo          (things only Nayo may do, shared-file edits, a suggested commit message)
  Then say in the terminal that you've handed off and name the file. More instructions for the same task update that same file.
EOF
}

# Brief $1 as a worker sees it inline: the header's after:, redo: and why: lines dropped (the
# Already done block covers after:), and for a claude worker ($2) the `## Libraries and design
# rules` section too (the daemon appends that knowledge to its system prompt). The file is unchanged.
brief_for_worker() {
  awk -v kn="$([ "$2" = claude ] && echo 1 || echo 0)" '
    /^## / { body = 1; sub(/[[:space:]]+$/, ""); skip = (kn == 1 && $0 == "## Libraries and design rules") }
    !body && /^(after|redo|why):/ { next }
    !skip' "$1"
}

# A worker's opening prompt: who it is, the worker rules and brief $1 inline (shown as $3), and
# with an --after handoff $2 (shown as $4) its What changed and Files sections; $5 = the worker kind.
worker_prompt() {
  local done
  printf "You are a Nayo worker. Your brief and the worker rules are below; don't open AGENTS.md or the brief file (%s), everything you need from them is here." "$3"
  printf '\n\n## Worker rules\n\n%s' "$(worker_rules)"
  printf '\n\n## Your brief\n\n%s' "$(brief_for_worker "$1" "$5")"
  if [ -n "$2" ]; then
    done=$(awk '/^## /{sub(/[[:space:]]+$/, ""); on = ($0 == "## What changed" || $0 == "## Files"); if (on) print; next} on' "$2" 2>/dev/null | head -40)
    printf '\n\n## Already done\n\n%s\n\nThat is from %s, which records what is already done: start from there. The full handoff is %s; grep it, don'"'"'t read it whole.' \
      "${done:-(its What changed and Files sections are empty)}" "$4" "$4"
  fi
}

# The lessons in handoffs/LESSONS.md that match brief $1's File scope, as a short block
# (at most 10 lines) for the end of a worker's prompt; nothing when none match or it fails.
lessons_block() {
  local b
  have python3 && [ -f "$BIN/nayo-lessons.py" ] && [ -f "$H/LESSONS.md" ] || return 0
  b=$(cd "$ROOT" && python3 -I "$BIN/nayo-lessons.py" select --brief "$1" 2>/dev/null) || return 0
  [ -n "$b" ] && printf '\n\n%s' "$b"
}

# cmd_spawn's isolated tail; uses its locals (brief, after, follow, why, worker, model,
# effort, dry, force) and ASKS.
spawn_isolated() {
  local account prompt cmd out id mainbr orig="" line
  account=$(field account "$brief" | awk '{print $1}')
  if [ "$worker" = claude ] && [ -n "$account" ] && [ "$account" != 1 ] && [ ! -d "$HOME/.claude-$account" ]; then
    die "no ~/.claude-$account: log that account in first (CLAUDE_CONFIG_DIR=~/.claude-$account claude, then /login)"
  fi
  iso_prepare "$brief"
  mainbr=$(git symbolic-ref --short HEAD 2>/dev/null || echo main)
  orig=$(field merges "$brief")

  prompt="$(worker_prompt "$brief" "$after" "$(iso_abs "$brief")" "${after:+$(iso_abs "$after")}" "$worker")"$'\n\n'
  prompt="${prompt}You are isolated: your working directory $ISO_WT is your own git worktree on branch $ISO_BR, so edit, build and test only inside it (the brief's repo paths are relative to it). Write your handoff to the main checkout, $ROOT/handoffs/ (an absolute path), and list files relative to the repo as usual."
  if [ -n "$orig" ]; then
    prompt="$prompt This brief is a merge: run git merge $mainbr inside $ISO_WT — the one git command you may run that changes state (git merge --abort to start over); never commit, Nayo commits the merge."
  else
    prompt="$prompt Still never run git commands that change state: Nayo commits your branch."
  fi
  [ "$worker" = opencode ] && prompt="$prompt Touch only the files it lists."
  prompt="$prompt Put every question in one first handoff (status: blocked); once answered, finish this brief and hand off.$(owner_prompt)"
  prompt="$prompt$(lessons_block "$brief")"
  cmd=$(iso_command "$worker" "$model" "$effort" "$account" "$prompt")
  [ -n "$account" ] && [ "$account" != 1 ] && [ "$worker" = claude ] && effort="${effort:+$effort }acct $account"

  if [ "$dry" = 1 ]; then
    id="dry-$(date +%s)-$$"
    echo "no terminal (--no-terminal): in $ISO_WT, run:"
    printf '  %s\n' "$cmd"
  elif id=$(ledger_get "$rid"); then
    ledger_note "$brief" "$id"
  else
    out=$(superset terminals create --workspace "$WS" --cwd "$ISO_WT" --command "$cmd" --json 2>&1) || die "isolated spawn failed: $out (the worktree $ISO_WT stays; spawn again to reuse it)"
    id=$(printf '%s' "$out" | jq -r '.terminalId // .sessionId // empty' 2>/dev/null)
    [ -n "$id" ] || die "no terminalId in: $out"
    ledger_put "$rid" "$id"
  fi

  set_started "$brief" "$id" || echo "nayo: couldn't record started: in $brief" >&2
  brief_follows "$brief" "$follow" "$after" "$why" || echo "nayo: couldn't record ${follow:-follow} in $brief (no started: line?)" >&2
  iso_header "$brief" "$ISO_WT" "$ISO_BR" || echo "nayo: couldn't record isolate: in $brief (no started: line?)" >&2
  line="- $(date '+%Y-%m-%d %H:%M') · $worker/${model:-default}${effort:+ $effort} · term $id · $brief · isolate: $ISO_WT · branch: $ISO_BR"
  open_add_running "$line"
  echo "spawned $(short "$id")${ASKS:+ · $ASKS ·} $worker/${model:-default}${effort:+ $effort} ← $brief · isolated on $ISO_BR (Claude sessions $(claude_sessions) of $NAYO_MAX_CLAUDE)"
}

# For `status`: an isolated running line $1 gets its branch and how far behind it is.
iso_status() {
  local br behind mainbr
  br=$(printf '%s' "$1" | sed -n 's/.* · branch: \([^ ]*\).*/\1/p')
  [ -n "$br" ] || return 0
  mainbr=$(git symbolic-ref --short HEAD 2>/dev/null || echo HEAD)
  if git show-ref --verify --quiet "refs/heads/$br"; then
    behind=$(git rev-list --count "$br..HEAD" 2>/dev/null || echo ?)
    printf '      isolated on %s · %s commit(s) behind %s\n' "$br" "$behind" "$mainbr"
  else
    printf '      isolated on %s · branch is gone\n' "$br"
  fi
}

worker_trailer() { # $1 = the handoff's agent: line
  case "$1" in
    claude*) echo "Co-Authored-By: Claude Code <$(printf '%s' "$1" | awk '{print $2}')> worker" ;;
    codex*) echo "Co-Authored-By: Codex <$(printf '%s' "$1" | awk '{print $2}')> worker" ;;
    opencode*) echo "Co-Authored-By: OpenCode <$(printf '%s' "$1" | awk '{print $2}')> worker" ;;
    grok*) echo "Co-Authored-By: Grok <$(printf '%s' "$1" | awk '{print $2}')> worker" ;;
  esac
}

# Every path changed in worktree $1 since commit $2: committed, uncommitted, untracked.
iso_changed() {
  { git -C "$1" diff --name-only "$2" -- 2>/dev/null
    git -C "$1" ls-files --others --exclude-standard 2>/dev/null; } | sort -u
}

# cmd_merge for an isolated handoff; uses its locals (ho, check, msg, outcome, push, keep,
# force, status, brief, agent, files, red, red_why, anyway).
merge_isolated() {
  local wt br mainbr base merging=0 changed other f bad=0 unmerged dirty trailer title
  local mt rc tree conflicts touched outside dest term old_tracked=0 orig obrief oterm sha line left pb=""
  wt=$(iso_path "$brief"); br=$(iso_branch "$brief")
  git -C "$wt" rev-parse --git-dir >/dev/null 2>&1 || die "$brief says isolate: $wt, but that worktree is gone"
  [ -n "$br" ] || br=$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null)
  git show-ref --verify --quiet "refs/heads/$br" || die "no branch $br"
  mainbr=$(git symbolic-ref --short HEAD 2>/dev/null) || die "the main checkout isn't on a branch"
  if git -C "$wt" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    merging=1; base=$(git -C "$wt" rev-parse MERGE_HEAD)   # a merge brief's `git merge main`, not committed yet
  else
    base=$(git merge-base HEAD "$br") || die "$br shares no history with $mainbr"
  fi

  echo "$ho · status: $status · brief: $brief · isolated: $br in $wt"
  changed=$(iso_changed "$wt" "$base")
  # changes outside the brief's File scope go back to the branch point (a dry run names them)
  if brief_checked "$brief"; then
    if [ $merging = 1 ]; then
      echo "  scope: a merge is in progress in the worktree, so nothing is put back"
    elif [ $check = 1 ] || [ "$status" = blocked ]; then
      pb=$(iso_outside "$brief" "$ho" "$wt" "$base")
      [ -z "$pb" ] || { echo "  scope: the merge puts these back on $br (outside the File scope):"; printf '%s\n' "$pb" | sed 's/^/    /'; }
    else
      pb=$(iso_put_back "$brief" "$ho" "$wt" "$base" "$br") || exit 1
      if [ -n "$pb" ]; then
        echo "  scope: put back on $br (outside the File scope; listed in the handoff):"
        printf '%s\n' "$pb" | sed 's/^/    /'
        files=$(printf '%s\n' $files | grep -vxF "$pb")
        changed=$(iso_changed "$wt" "$base")
      fi
    fi
  fi
  for f in $files; do
    printf '%s\n' "$changed" | grep -qxF "$f" || { echo "  ✗ listed but not changed (in the worktree): $f"; bad=1; }
  done
  other=$(printf '%s\n' "$changed" | grep -v "^$H/" | grep -vxF "$files" | grep -v '^$')
  if [ -n "$other" ]; then
    echo "  other changes in the worktree (missing from this list; they are not merged):"
    printf '%s\n' "$other" | head -n 12 | sed 's/^/    /'
  fi
  # the worker doesn't stage, so a conflicted path still shows unmerged in the index: it's
  # resolved once its markers are gone (and it's listed, so the commit stages it)
  unmerged=""
  for f in $(git -C "$wt" diff --name-only --diff-filter=U 2>/dev/null); do
    if [ -f "$wt/$f" ] && grep -qE '^(<<<<<<<|>>>>>>>)( |$)' "$wt/$f"; then unmerged="$unmerged$f (conflict markers)
"
    elif ! printf '%s\n' $files | grep -qxF "$f"; then unmerged="$unmerged$f (not in the handoff's list)
"
    fi
  done
  unmerged=$(printf '%s' "$unmerged" | grep -v '^$')
  [ -z "$unmerged" ] || { echo "  ✗ unresolved conflicts in the worktree:"; printf '%s\n' "$unmerged" | sed 's/^/    /'; bad=1; }
  git -C "$wt" diff --stat "$base" -- $files 2>/dev/null | sed 's/^/  /'
  for f in $files; do
    git -C "$wt" cat-file -e "$base:$f" 2>/dev/null || [ ! -f "$wt/$f" ] || echo "   new: $f ($(wc -l < "$wt/$f" | tr -d ' ') lines)"
  done
  dirty=$(git status --porcelain -uall -- $files 2>/dev/null | cut -c4- | sed -e 's/.* -> //' -e 's/^"//' -e 's/"$//')
  [ -z "$dirty" ] || { echo "  ✗ uncommitted changes in the main checkout in listed files:"; printf '%s\n' "$dirty" | sed 's/^/    /'; }
  merge_checks "$brief" "$ho" "$wt"   # the Araniko checks, then scope and acceptance; sets red
  second_opinion "$ho"
  [ $check = 1 ] && { verify_run "$ho" "$wt" "$base"; [ -z "$dirty" ] && [ -z "$so_block" ] || exit 1; exit $((bad | red)); }

  [ "$status" = blocked ] && die "status is blocked — answer its questions first"
  checks_gate
  [ -z "$unmerged" ] || die "resolve the conflicts in $wt first"
  [ $bad = 1 ] && [ $force = 0 ] && die "file list doesn't match the worktree — send it back, or --force"
  [ -z "$dirty" ] || die "the main checkout has uncommitted changes in listed files — commit or move them first"
  git diff --cached --quiet || die "the main checkout has staged changes; the merge commit would take them — commit or unstage them first"
  second_opinion_gate "$ho"
  team_guard "$push"
  checks_anyway_log "$ho"

  # 1. commit the listed files on the branch, inside the worktree
  title=$(sed -n '1s/^#[[:space:]]*//p' "$ho")
  [ -n "$msg" ] || msg="$title"
  trailer=$(worker_trailer "$agent")
  for f in $files; do
    { [ -e "$wt/$f" ] || git -C "$wt" ls-files --error-unmatch -- "$f" >/dev/null 2>&1; } || continue
    git -C "$wt" add -A -- "$f" || die "git add failed in $wt: $f"
  done
  if [ $merging = 1 ]; then
    git -C "$wt" commit -q --no-edit -m "$msg" -m "Merges $mainbr into $br." ${trailer:+-m "$trailer"} || die "commit of the merge in $wt failed"
  elif ! git -C "$wt" diff --cached --quiet -- $files; then
    git -C "$wt" commit -q -m "$msg" ${trailer:+-m "$trailer"} -- $files || die "commit in $wt failed"
  else
    echo "  $br already has the listed files committed"
  fi

  # 2. try the merge without a working tree: conflicts, and what it would touch here
  mt=$(git merge-tree --write-tree --name-only --no-messages HEAD "$br" 2>&1); rc=$?
  if [ $rc = 1 ]; then
    conflicts=$(printf '%s\n' "$mt" | sed '1d' | grep -v '^$' | sort -u)
    iso_conflict
    return 1
  fi
  [ $rc = 0 ] || die "git merge-tree failed: $mt"
  tree=$(printf '%s\n' "$mt" | sed -n 1p)
  touched=$(git diff --name-only HEAD "$tree")
  [ -n "$touched" ] || die "$br adds nothing to $mainbr"
  outside=$(printf '%s\n' "$touched" | grep -vxF "$files" | grep -v '^$')
  [ -z "$outside" ] || die "merging $br would also change paths not in the handoff: $(printf '%s ' $outside)— list them, or fix the branch in $wt"
  dirty=$(git status --porcelain -uall -- $touched 2>/dev/null)
  [ -z "$dirty" ] || die "the main checkout has uncommitted changes in paths the merge touches: $(printf '%s' "$dirty" | cut -c4- | tr '\n' ' ')"

  # 3. the real merge, then the bookkeeping folded into the merge commit
  if ! git merge -q --no-ff --no-edit -m "$msg" -m "Merges $br (isolated worker)." "$br" >/dev/null 2>&1; then
    git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && git merge --abort
    die "git merge $br failed; the main checkout is as it was"
  fi

  mkdir -p "$H/merged"
  dest="$H/merged/$(owner_name "$(basename "$ho")")"
  term=$(sed -n 's/.*terminal:[[:space:]]*\([^ ]*\).*/\1/p' "$brief" 2>/dev/null | head -n 1)
  case "$term" in ""|\<*) term="" ;; esac
  open_drop "$brief"
  open_drop "$(basename "$ho")"
  git ls-files --error-unmatch -- "$ho" >/dev/null 2>&1 && old_tracked=1
  mv "$ho" "$dest"
  set -- "$dest"
  rv="$H/reviews/$(basename "$ho" .md)-second.md"; [ -f "$rv" ] && set -- "$@" "$rv"
  [ $old_tracked = 1 ] && set -- "$@" "$ho"
  [ -f "$brief" ] && set -- "$@" "$brief"
  # a merge brief's handoff closes the original one too: its handoff, brief and terminal
  orig=$(field merges "$brief")
  if [ -n "$orig" ] && [ -f "$orig" ]; then
    obrief=$(field brief "$orig" | awk '{print $1}')
    oterm=$(sed -n 's/.*terminal:[[:space:]]*\([^ ]*\).*/\1/p' "$obrief" 2>/dev/null | head -n 1)
    [ -n "$obrief" ] && open_drop "$obrief"
    open_drop "$(basename "$orig")"
    git ls-files --error-unmatch -- "$orig" >/dev/null 2>&1 && set -- "$@" "$orig"
    mv "$orig" "$H/merged/$(owner_name "$(basename "$orig")")"; set -- "$@" "$H/merged/$(owner_name "$(basename "$orig")")"
    [ -n "$obrief" ] && [ -f "$obrief" ] && set -- "$@" "$obrief"
  fi
  [ -f "$OPEN" ] && set -- "$@" "$OPEN"
  for f; do { [ -e "$f" ] || git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; } || continue; git add -A -- "$f" || die "git add failed: $f"; done
  git commit -q --amend --no-edit -- "$@" || die "folding the handoff move into the merge commit failed (the merge itself is committed)"
  sha=$(git rev-parse --short HEAD)
  line="merged $sha · $(printf '%s\n' $files | wc -l | tr -d ' ') files from $br"

  if [ "$push" = 1 ]; then
    if [ -n "$TEAM_CONF" ]; then
      line="$line · $(team_push)"
    elif git push -q 2>/dev/null; then line="$line · pushed"; else line="$line · push FAILED (run git push)"; fi
  fi
  if [ $keep = 0 ] && [ -n "$WS" ]; then
    [ -n "$term" ] && superset terminals close --workspace "$WS" --terminal "$term" >/dev/null 2>&1 && line="$line · closed $(short "$term")"
    case "${oterm:-}" in ""|\<*) ;; *) superset terminals close --workspace "$WS" --terminal "$oterm" >/dev/null 2>&1 && line="$line · closed $(short "$oterm")" ;; esac
  fi
  if [ -n "$outcome" ] && [ -x "$BIN/jev.sh" ]; then
    "$BIN/jev.sh" outcome "$brief" "$outcome" >/dev/null 2>&1
  fi

  # 4. the worktree and branch go, unless the worker left files there that weren't listed
  left=$(git -C "$wt" status --porcelain -uall 2>/dev/null)
  if [ -n "$left" ]; then
    line="$line · kept $wt: $(printf '%s\n' "$left" | wc -l | tr -d ' ') unlisted change(s) there (nayo clean-worktrees removes it)"
  elif git worktree remove --force "$wt" >/dev/null 2>&1 && iso_rm_targets "$wt" && git branch -q -d "$br" >/dev/null 2>&1; then
    line="$line · removed $br and its worktree"
  else
    line="$line · couldn't remove $wt / $br (nayo clean-worktrees)"
  fi
  echo "$line · $(basename "$OPEN") updated in the same commit"
  return 0
}

# merge_isolated's conflict path: nothing here changed (merge-tree needs no working tree),
# the worktree and branch stay, and a ready-to-spawn merge brief is written: an opus/high
# isolated worker merges the main branch into jw/<slug> there, keeping both intents.
iso_conflict() {
  local f sha m others="" ts mb slug tasks checks
  echo "conflict merging $br into $mainbr (nothing in the main checkout changed):"
  printf '%s\n' "$conflicts" | sed 's/^/  /'
  for f in $conflicts; do # the handoffs merged on the main branch that touched these paths
    for sha in $(git log --first-parent --format=%H "$(git merge-base HEAD "$br")..HEAD" -- "$f" 2>/dev/null); do
      # against the first parent: an isolated merge's handoff move is in the merge commit
      for m in $(git diff-tree --no-commit-id --name-only -r --diff-filter=A "$sha^1" "$sha" -- "$H/merged/" 2>/dev/null); do
        case " $others " in *" $m "*) ;; *) others="$others $m" ;; esac
      done
    done
  done
  ts=$(date '+%Y-%m-%d-%H%M'); slug=${br#jw/}
  mb="$H/briefs/$(owner_name "$ts-merge-$slug.md")"
  tasks=$(awk '/^## /{exit} /^Tasks:/{print; exit}' "$brief")
  checks=$(awk '/^## /{on = ($0 ~ /^## Checks/); next} on' "$brief" | sed -e '/./,$!d')
  {
    echo "# Merge $mainbr into $br: conflicts in $(printf '%s ' $conflicts | sed 's/ $//')"
    echo "worker: claude"
    echo "model: claude-opus-5-5"
    echo "effort: high"
    echo "started: <filled in by nayo spawn>"
    [ -n "$tasks" ] && echo "$tasks"
    echo "isolate: $wt · branch: $br"
    echo "merges: $ho"
    echo
    echo "## Goal"
    echo "Branch \`$br\` (worktree \`$wt\`) and \`$mainbr\` both changed the same lines. In that worktree, run \`git merge $mainbr\` and resolve every conflict so **both intents survive**: what \`$br\` did (its handoff, below) and what landed on \`$mainbr\` since it branched. Then build and test there, and hand off. Done = no conflict markers left, the checks below pass in the worktree, and the handoff lists every file."
    echo
    echo "## Context"
    echo "- The branch's handoff (what it changed and why): \`$ROOT/$ho\`"
    if [ -n "$others" ]; then
      for m in $others; do echo "- Landed on \`$mainbr\` in these paths: \`$ROOT/$m\`"; done
    else
      echo "- What landed on \`$mainbr\` in these paths: \`git log $(git merge-base HEAD "$br" | cut -c1-9)..$mainbr -- <path>\` (no merged handoff found for it)"
    fi
    echo "- Conflicting paths:"
    for f in $conflicts; do echo "  - \`$f\`"; done
    echo
    echo "## Scope"
    echo "- Work only inside \`$wt\`. The one git command you run that changes state is \`git merge $mainbr\` there (\`git merge --abort\` to start over); read-only git is fine. Don't stage by hand, don't commit: Nayo commits the merge."
    echo "- May touch (in the worktree): $(printf '`%s` ' $files | sed 's/ $//')"
    echo "- Must not touch: anything else, and nothing in the main checkout except your handoff."
    echo
    echo "## Phase"
    echo "1. \`cd $wt && git merge $mainbr\`"
    echo "2. Resolve each conflicting path by hand, keeping both changes; then the checks."
    echo "3. Write the handoff to \`$ROOT/handoffs/$(owner_name "$ts-merge-$slug.md")\` with \`brief: $mb\`. Its \`## Files\` lists every file of the branch's handoff above, plus any other path you had to edit."
    echo
    echo "## Checks"
    if [ -n "$checks" ]; then printf '%s\n' "$checks"; else echo "The repo's checks line (CLAUDE.md), run in the worktree."; fi
    echo
    echo "## Questions first"
    echo "Put every question in one first handoff (\`status: blocked\`) and stop. After"
    echo "the answers arrive on your terminal, finish this phase without stopping"
    echo "again. If you have no questions, build straight through."
  } > "$mb"
  echo "kept $wt and $br. Merge brief written: $mb"
  echo "  next: handoffs/bin/nayo spawn $mb   (its handoff then merges through nayo merge as usual)"
}

# Remove isolated worktrees and jw/* branches that no running worker uses and whose
# handoff is merged (in handoffs/merged/, and the branch already in HEAD). List the rest.
cmd_clean_worktrees() {
  local wt br briefs b merged reason n=0 kept=0 entries
  entries=$( { git worktree list --porcelain 2>/dev/null | awk '
      /^worktree /{wt = substr($0, 10)} /^branch refs\/heads\/jw\//{print wt "\t" substr($0, 19)}'
    for br in $(git for-each-ref --format='%(refname:short)' 'refs/heads/jw/'); do
      git worktree list --porcelain 2>/dev/null | grep -qx "branch refs/heads/$br" || printf '\t%s\n' "$br"
    done; } )
  while IFS="$(printf '\t')" read -r wt br; do
    [ -n "$br" ] || continue
    reason=""
    if running_lines | grep -q " · branch: $br\$"; then reason="a worker is running on it"
    else
      briefs=$(grep -l "^isolate:.*branch: $br\$" "$H"/briefs/*.md 2>/dev/null)
      merged=0
      for b in $briefs; do grep -lq "^brief:[[:space:]]*$b" "$H"/merged/*.md 2>/dev/null && merged=1; done
      if [ $merged = 0 ]; then reason="its handoff isn't merged"
      elif ! git merge-base --is-ancestor "$br" HEAD 2>/dev/null; then reason="its handoff is merged, but the branch has commits $(git symbolic-ref --short HEAD 2>/dev/null) doesn't"
      fi
    fi
    if [ -n "$reason" ]; then
      kept=$((kept + 1)); echo "kept $br${wt:+ ($wt)}: $reason"
      continue
    fi
    [ -z "$wt" ] || git worktree remove --force "$wt" >/dev/null 2>&1 || { echo "couldn't remove $wt"; continue; }
    [ -z "$wt" ] || iso_rm_targets "$wt"
    git branch -q -D "$br" >/dev/null 2>&1 && { n=$((n + 1)); echo "removed $br${wt:+ and $wt}"; }
  done <<EOF
$entries
EOF
  git worktree prune 2>/dev/null
  echo "clean-worktrees: $n removed · $kept kept"
}

# ---------------------------------------------------------------- events

# For Claude Code's Monitor tool: Nayo arms Monitor on `handoffs/bin/nayo events`
# and each stdout line arrives as a notification, so nothing is typed into its prompt.
# One "[nayo event] …" line per thing that needs Nayo:
#   handoff.written <path> (<status>)      a handoff landed or changed (path + mtime + status)
#   session.limit_hit <id> <brief>         a usage limit on a worker's screen (once an hour)
#   session.exited <id> <brief>            a running worker's terminal exited or closed
#   session.stalled <id> <brief>           a worker with no handoff yet whose screen hasn't
#                                          changed for EVENTS_STALL_MIN minutes
# What it has reported lives in $STATE/events.seen, so a Monitor re-armed after a timeout
# or a /clear picks up what landed in between; a first run only learns what's there.
# The newest `nayo events` wins: an older one still running stops at its next pass.
EVENTS_SEC=20
EVENTS_STALL_MIN=10

events_once() { # $1 = key: 0 the first time it's seen, 1 after
  grep -qxF "$1" "$STATE/events.seen" && return 1
  echo "$1" >> "$STATE/events.seen"
}

handoff_files() { # dated handoffs only (not OPEN.md, NOTES.md, …)
  local ho
  for ho in "$H"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.md; do [ -f "$ho" ] && echo "$ho"; done
}

events_tick() {
  local ho st live line id brief scr h f since now_
  while IFS= read -r ho; do
    [ -n "$ho" ] || continue
    st=$(field status "$ho")
    events_once "ho $ho $(mtime "$ho") $st" && echo "[nayo event] handoff.written $ho (${st:-?})"
  done <<EOF
$(handoff_files)
EOF
  [ -n "$WS" ] && have superset && have jq || return 0
  live=$(superset terminals list --workspace "$WS" --json 2>/dev/null \
    | jq -r '.sessions[]? | select(.exited | not) | .terminalId' 2>/dev/null)
  while IFS= read -r line; do
    id=$(printf '%s' "$line" | sed -n 's/.*term \([^ ]*\).*/\1/p')
    [ -n "$id" ] || continue
    brief=$(printf '%s' "$line" | grep -o "$H/briefs/[^ ]*\.md" | head -n 1)
    if [ -n "$live" ] && ! printf '%s\n' "$live" | grep -qxF "$id"; then
      events_once "gone $id" && echo "[nayo event] session.exited $(short "$id") ${brief:-?}"
      continue
    fi
    scr=$(superset terminals read --workspace "$WS" --terminal "$id" --max-lines 20 --json 2>/dev/null \
      | jq -r '.text // empty' 2>/dev/null)
    [ -n "$scr" ] || continue
    if printf '%s' "$scr" | grep -Eiq "$LIMIT_RE"; then
      events_once "limit $id $(date +%Y%m%d%H)" && echo "[nayo event] session.limit_hit $(short "$id") ${brief:-?}"
    fi
    # stalled: the screen minus spinner/timer lines unchanged, and no handoff for its brief yet
    [ -n "$brief" ] && grep -lq "^brief:[[:space:]]*$brief" "$H"/*.md 2>/dev/null && continue
    h=$(printf '%s' "$scr" | grep -vE '…|tokens|esc to interrupt' | cksum | tr -d ' \t')
    f="$STATE/events-screen-$id"; now_=$(now)
    if [ -f "$f" ] && [ "$(cut -d' ' -f1 "$f")" = "$h" ]; then
      since=$(cut -d' ' -f2 "$f")
      if [ $((now_ - since)) -ge $((EVENTS_STALL_MIN * 60)) ] && ! printf '%s' "$scr" | grep -q '…'; then
        events_once "stall $id $h" && echo "[nayo event] session.stalled $(short "$id") ${brief:-?} (screen unchanged ${EVENTS_STALL_MIN}+ min)"
      fi
    else
      echo "$h $now_" > "$f"
    fi
  done <<EOF
$(running_lines)
EOF
}

# ---------------------------------------------------------------- send, read, close

need_superset() {
  have superset || die "the superset CLI isn't on PATH"
  [ -n "$WS" ] || die "SUPERSET_WORKSPACE_ID not set"
}

# The full id of Superset terminal $1: a full id, or a unique prefix (6+ characters) of a
# terminal still running in this workspace. Dies when none or several match.
term_id() {
  local id="$1" ids n
  case "$id" in s_*) die "$id is an Araniko session: run NAYO_HOST=araniko handoffs/bin/nayo $cmd …" ;; esac
  [ ${#id} -ge 36 ] && { printf '%s' "$id"; return 0; }
  [ ${#id} -ge 6 ] || die "$id: give at least 6 characters of the terminal id"
  have jq || die "jq is needed to match a terminal id prefix"
  ids=$(superset terminals list --workspace "$WS" --json 2>/dev/null | jq -r --arg p "$id" '
    .sessions[]? | select((.exited | not) and (.terminalId | startswith($p))) | .terminalId' 2>/dev/null)
  n=$(printf '%s' "$ids" | grep -c .)
  case $n in
    1) printf '%s' "$ids" ;;
    0) die "no running terminal starting $id in this workspace" ;;
    *) die "$id matches $n terminals: give more of it" ;;
  esac
}

sup_err() { # Superset's error from its output $1, on one line
  printf '%s\n' "$1" | sed -n 's/^Error: //p; /"error"/p' | head -n 1 | cut -c1-160 | grep . \
    || printf '%s\n' "$1" | sed -n '/[^[:space:]]/{p;q;}' | cut -c1-160
}

# Type $2 into terminal $1 and press Enter, or (`--keys enter`) press Enter alone. Superset
# reports whether Enter took (`submitted`); "typed but not submitted" exits non-zero.
cmd_send() {
  local id="${1:-}" full text out
  [ -n "$id" ] && [ $# -ge 2 ] || die 'usage: nayo send <terminal> "<text>" | nayo send <terminal> --keys enter'
  need_superset
  full=$(term_id "$id") || exit 1
  if [ "$2" = --keys ]; then
    [ "${3:-}" = enter ] || die "--keys takes one key: enter"
    out=$(superset terminals send --workspace "$WS" --terminal "$full" --keys enter --json 2>&1) \
      || die "couldn't send to $id: $(sup_err "$out")"
    echo "pressed Enter in $full"
    return 0
  fi
  text="$2"
  out=$(superset terminals send --workspace "$WS" --terminal "$full" --text "$text" --json 2>&1) \
    || die "couldn't send to $id: $(sup_err "$out")"
  if have jq && [ "$(printf '%s' "$out" | jq -r '.submitted // empty' 2>/dev/null)" = false ]; then
    die "typed but not submitted — run: nayo send $id --keys enter, then nayo read $id"
  fi
  echo "sent to $full (submitted)"
}

# Terminal $1's screen, last $2 lines, as plain text.
cmd_read() {
  local id="${1:-}" full out
  [ -n "$id" ] || die "usage: nayo $cmd <terminal> [lines]"
  need_superset
  full=$(term_id "$id") || exit 1
  out=$(superset terminals read --workspace "$WS" --terminal "$full" --max-lines "${2:-60}" --json 2>&1) \
    || die "couldn't read $id: $(sup_err "$out")"
  printf '%s\n' "$out" | { have jq && jq -r '.text // empty' || cat; }
}

# Close terminal $1: prints "closed <full id>", or "✗ couldn't close <id>: <Superset's error>"
# and exits non-zero.
cmd_close() {
  local id="${1:-}" full out
  [ -n "$id" ] || die "usage: nayo close <terminal>"
  need_superset
  full=$(term_id "$id") || exit 1
  if out=$(superset terminals close --workspace "$WS" --terminal "$full" --json 2>&1); then
    echo "closed $full"
    return 0
  fi
  echo "✗ couldn't close $id: $(sup_err "$out") (the worker is still open)"
  return 1
}

cmd_events() {
  local ho
  mkdir -p "$STATE"
  if [ ! -f "$STATE/events.seen" ]; then # first run: learn what's already there, silently
    : > "$STATE/events.seen"
    while IFS= read -r ho; do
      [ -n "$ho" ] && echo "ho $ho $(mtime "$ho") $(field status "$ho")" >> "$STATE/events.seen"
    done <<EOF
$(handoff_files)
EOF
  fi
  echo $$ > "$STATE/events.pid"
  while [ "$(cat "$STATE/events.pid" 2>/dev/null)" = $$ ]; do
    events_tick
    sleep "$EVENTS_SEC"
  done
}

# ---------------------------------------------------------------- hooks

# UserPromptSubmit, Nayo's terminal only: after a long idle the prompt cache has
# expired, and the next turn would write the whole context again. Stop the prompt
# once and suggest /clear; sending it again goes through.
hook_prompt() {
  local in sid tp prompt me last gap ctx model price usd marker
  have jq || exit 0
  in=$(cat)
  me="${SUPERSET_TERMINAL_ID:-}"
  [ -n "$me" ] && [ "$me" = "$(nayo_terminal)" ] || exit 0
  sid=$(printf '%s' "$in" | jq -r '.session_id // empty')
  tp=$(printf '%s' "$in" | jq -r '.transcript_path // empty')
  prompt=$(printf '%s' "$in" | jq -r '.prompt // empty')
  [ -n "$sid" ] && [ -f "$tp" ] || exit 0
  mkdir -p "$STATE"
  case "$prompt" in /*) exit 0 ;; esac

  last=$(tail -n 400 "$tp" | jq -c 'select(.type == "assistant" and .message.usage) |
      {t: .timestamp, m: .message.model, u: .message.usage}' 2>/dev/null | tail -n 1)
  [ -n "$last" ] || exit 0
  gap=$(printf '%s' "$last" | jq -r --argjson now "$(now)" \
    '(.t | sub("\\.[0-9]+"; "") | fromdateiso8601) as $t | (($now - $t) / 60 | floor)' 2>/dev/null) || exit 0
  ctx=$(printf '%s' "$last" | jq -r '.u | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)')
  model=$(printf '%s' "$last" | jq -r '.m // ""')
  [ "$gap" -ge "$NAYO_IDLE_MIN" ] && [ "$ctx" -ge "$NAYO_GUARD_TOKENS" ] || exit 0

  marker="$STATE/guard-$sid"
  if [ -f "$marker" ] && [ $(( $(now) - $(mtime "$marker") )) -lt 900 ]; then rm -f "$marker"; exit 0; fi
  touch "$marker"
  case "$model" in
    *fable*) price=20 ;; *opus-5-5*) price=8 ;; *opus*) price=10 ;; *sonnet*) price=4 ;; *haiku*) price=2 ;; *) price=10 ;;
  esac
  usd=$(awk -v t="$ctx" -v p="$price" 'BEGIN{printf "%.2f", t * p / 1000000}')
  jq -n --arg r "Nayo has been idle ${gap} min, so its prompt cache has expired: this message would write all $((ctx / 1000))k tokens of context again (about \$${usd} at API prices). Cheaper: /clear, then \"resume\" — Nayo reloads from $OPEN. To go ahead anyway, send your message again." \
    '{decision: "block", reason: $r}'
}

# Statusline tap: Claude Code hands the statusline its rate-limit numbers. Save
# them for `nayo band`, then run the user's own statusline unchanged.
cmd_statusline() {
  local in cmd tmp
  in=$(cat)
  if have jq; then
    mkdir -p "$STATE" 2>/dev/null
    tmp="$STATE/usage.json.$$"
    printf '%s' "$in" | jq -c --argjson ts "$(now)" 'select(.rate_limits.five_hour) | .rate_limits + {ts: $ts}' \
      > "$tmp" 2>/dev/null && [ -s "$tmp" ] && mv "$tmp" "$STATE/usage.json"
    rm -f "$tmp"
    cmd="${NAYO_STATUSLINE_CMD:-$(jq -r '.statusLine.command // empty' "$HOME/.claude/settings.json" 2>/dev/null)}"
  else
    cmd="${NAYO_STATUSLINE_CMD:-}"
  fi
  case "$cmd" in *"nayo statusline"*) cmd="" ;; esac
  if [ -n "$cmd" ]; then printf '%s' "$in" | sh -c "$cmd"
  elif have jq; then printf '%s' "$in" | jq -r '"\(.model.display_name // "") · 5h \(.rate_limits.five_hour.used_percentage // "?" | tostring | .[0:4])%"'
  fi
}

# ---------------------------------------------------------------- usage

cmd_usage() {
  local audit proj since_arg json merged
  have python3 || die "python3 is needed for nayo usage"
  have jq || die "jq is needed for nayo usage"
  audit="$(cd "$(dirname "$0")" && pwd)/cc_usage_audit.py"
  [ -f "$audit" ] || die "no $audit — re-run nayo:setup"
  proj=$(printf '%s' "$ROOT" | sed 's#[^A-Za-z0-9]#-#g')
  set -- --project="$proj" \
    --role worker='^You are a (Nayo|Jarvis) worker' \
    --role-tool orchestrator='superset agents create|handoffs/bin/nayo (start|status|spawn|merge)' \
    --bash-category coordination='terminals (read|send|list|close)|handoffs/|OPEN\.md|jev\.sh|bin/nayo' \
    "$@"
  json=$(python3 "$audit" "$@" --json) || exit 1
  since_arg=$(printf '%s' "$json" | jq -r '.period[0]')
  merged=$(git log --since="$since_arg" --diff-filter=A --name-only --format= -- "$H/merged/*.md" 2>/dev/null | grep -c '\.md$')
  printf '%s' "$json" | jq -r --argjson merged "$merged" '
    def usd: "$" + ((. * 100 | round) / 100 | tostring);
    def role(r): [.by_role | to_entries[] | select(.key == r or .key == (r + " > subagents")) | .value.usd] | add // 0;
    (role("orchestrator")) as $coord | (role("worker")) as $build
    | "nayo usage · \(.period[0][0:16]) → \(.period[1][0:16]) · \(.total_usd | usd) in this repo at API prices",
      "  coordinating (Nayo + its subagents): \($coord | usd)",
      "  building (workers + their subagents):  \($build | usd)",
      "  coordinating ÷ building: \(if $build > 0 then ($coord / $build * 100 | round) / 100 else "n/a" end)   (target ≤ 0.3)",
      "  merged handoffs: \($merged) · cost per merged handoff: \(if $merged > 0 then (($coord + $build) / $merged) | usd else "n/a" end)",
      "  worst 5-hour window: \(.peak_window_usd | usd) · most sessions in one 10-min slot: \(.peak_concurrent_sessions_10min)",
      "  cache reloads after idle (Nayo): \([.reloads[] | select(.role == "orchestrator" and .cause == "after idle")] | "\(map(.turns) | add // 0) turns, \(map(.usd) | add // 0 | usd)")",
      "",
      "  Nayo by model (for comparing coordinator configs):",
      ([.by_role_model[]? | select(.role == "orchestrator")] | sort_by(-.usd)[]
        | "    \(.model): \(.turns) turns · \(.usd | usd) · $\((.usd / .turns * 1000 | round) / 1000)/turn · avg ctx \((.ctx / .turns / 1000) | round)k")'
}

# ---------------------------------------------------------------- lock

# `nayo lock` and `nayo resources` live in nayo-lock.pl beside this script (its header
# says how). They need only perl (macOS ships it; there's no flock(1)) and work with no
# OPEN.md, outside any host. The caller's directory is $OLDPWD: the cd to $ROOT above
# is the script's only one before this runs.
cmd_lock() { # $1 = lock|resources, then its arguments
  local d v
  d=$(dirname "$0"); case "$d" in /*) ;; *) d="$OLDPWD/$d" ;; esac
  if ! have perl; then
    # a CI runner has no other agents to queue behind, and minimal images have no perl
    case "$1:${CI:-}" in lock:|lock:0|lock:false|resources:*)
      echo "nayo $1: needs perl for the kernel lock, and there's none on PATH (nothing was run)" >&2; exit 2 ;;
    esac
    shift 2
    while [ $# -gt 0 ]; do case "$1" in --wait) shift 2 ;; --reuse) shift ;; --) shift; break ;; *) break ;; esac; done
    echo "nayo lock: no perl on this CI runner (CI=$CI), so running without the lease" >&2
    cd "$OLDPWD" && exec "$@"
  fi
  [ -f "$d/nayo-lock.pl" ] || { echo "nayo $1: no $d/nayo-lock.pl — run the Nayo setup again (nothing was run)" >&2; exit 2; }
  for v in $(compgen -v | grep -E '^(NAYO|JARVIS)_LOCK_'); do export "$v"; done
  NAYO_ROOT="$ROOT" NAYO_CALLER_PWD="$OLDPWD" exec perl "$d/nayo-lock.pl" "$@"
}

# ---------------------------------------------------------------- main

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  lock|resources) cmd_lock "$cmd" "$@" ;;
  start) cmd_start "$@" ;;
  status) cmd_status ;;
  band) cmd_band ;;
  spawn) cmd_spawn "$@" ;;
  merge) cmd_merge "$@" ;;
  events) cmd_events ;;
  usage) cmd_usage "$@" ;;
  statusline) cmd_statusline ;;
  lessons) exec python3 -I "$BIN/nayo-lessons.py" "$@" ;;
  hook)
    case "${1:-}" in
      prompt) hook_prompt ;;
      *) exit 0 ;;
    esac ;;
  clean-worktrees) cmd_clean_worktrees ;;
  screen|read) cmd_read "$@" ;;
  send) cmd_send "$@" ;;
  close) cmd_close "$@" ;;
  *) sed -n '2,/^# Settings live/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
